{
  "name": "mandacode-dev",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "translate:ui": "node scripts/translate-ui.mjs",
    "translate:content": "node scripts/translate-content.mjs",
    "content:sync": "node scripts/sync-content.mjs",
    "translate": "npm run translate:ui && npm run translate:content",
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.6.0",
    "astro": "^6.4.2",
    "astro-mermaid": "^2.0.2",
    "deepl-node": "^1.27.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
