---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto",
  width,
  height,
} = Astro.props;
---

<div
  class={`relative overflow-hidden bg-bg-secondary ${className}`}
  data-cover-image
>
  <div class="shimmer absolute inset-0 z-10" data-shimmer></div>
  <img
    src={src}
    alt={alt}
    class="relative w-full h-full object-cover opacity-0 transition-opacity duration-300"
    style="z-index: 11;"
    loading={loading}
    decoding="async"
    {width}
    {height}
    fetchpriority={fetchpriority}
    data-lazy-image
    onload="this.style.opacity='1'"
    onerror="this.style.opacity='1'; this.previousElementSibling.style.display='none'"
  />
</div>

<script>
  const containers = document.querySelectorAll("[data-cover-image]");
  for (const container of containers) {
    const img = container.querySelector(
      "[data-lazy-image]",
    ) as HTMLElement | null;
    const shimmer = container.querySelector(
      "[data-shimmer]",
    ) as HTMLElement | null;
    if (img) {
      img.addEventListener("load", () => {
        if (shimmer) shimmer.style.display = "none";
      });
      img.addEventListener("error", () => {
        if (shimmer) shimmer.style.display = "none";
      });
    }
  }
</script>
