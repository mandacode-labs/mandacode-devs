---
interface Props {
  variant?: "status" | "tech" | "default";
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const variants = {
  status:
    "bg-accent-subtle text-accent text-xs font-semibold px-2.5 py-0.5 rounded-full",
  tech: "bg-bg-secondary text-text-secondary text-xs font-medium px-2.5 py-0.5 rounded-md border border-border",
  default:
    "bg-bg-secondary text-text-secondary text-xs font-medium px-2.5 py-0.5 rounded-md",
};
---

<span class={`${variants[variant]} ${className}`}>
  <slot />
</span>
