---
interface Props {
  variant?: "status" | "tech" | "default";
  status?: "production" | "development" | "planning" | "completed";
  class?: string;
}

const { variant = "default", status, class: className = "" } = Astro.props;

const statusColors = {
  production: "bg-emerald-100 text-emerald-700",
  development: "bg-amber-100 text-amber-700",
  planning: "bg-gray-100 text-gray-600",
  completed: "bg-blue-100 text-blue-700",
};

const variants = {
  status: status
    ? `${statusColors[status]} text-xs font-semibold px-2.5 py-0.5 rounded-full`
    : "bg-accent-subtle text-accent text-xs font-semibold px-2.5 py-0.5 rounded-full",
  tech: "bg-bg-secondary text-text-secondary text-xs font-medium px-2.5 py-0.5 rounded-md border border-border",
  default:
    "bg-bg-secondary text-text-secondary text-xs font-medium px-2.5 py-0.5 rounded-md",
};
---

<span class={`${variants[variant]} ${className}`}>
  <slot />
</span>
