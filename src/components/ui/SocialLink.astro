---
import { Mail, Globe } from "lucide-react";
import Button from "@/components/ui/Button.astro";
import GithubIcon from "@/components/icons/Github.astro";
interface Props {
  platform: "github" | "email" | "website";
  href: string;
  size?: "sm" | "md" | "lg";
}

const { platform, href, size = "md" } = Astro.props;

const config = {
  github: {
    label: "GitHub",
    icon: GithubIcon,
  },
  email: {
    label: "Email",
    icon: Mail,
  },
  website: {
    label: "Website",
    icon: Globe,
  },
};

const { label, icon: Icon } = config[platform];
const isEmail = platform === "email";
const buttonHref = isEmail ? `mailto:${href}` : href;

const sizeClasses = {
  sm: "px-3 py-1.5 text-xs",
  md: "px-4 py-2 text-sm",
  lg: "px-6 py-3 text-base",
};
---

<Button href={buttonHref} variant="secondary" class={sizeClasses[size]}>
  <Icon size={16} />
  <span>{label}</span>
</Button>
