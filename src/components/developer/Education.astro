---
import { useTranslations } from "@/lib/i18n/utils";
import type { Lang } from "@/types";
import type { CollectionEntry } from "astro:content";

interface Props {
  developer: CollectionEntry<"developers">;
  lang: Lang;
}

const { developer, lang } = Astro.props;
const t = useTranslations(lang);

const education = developer.data.education;
---

{
  education && education.length > 0 && (
    <section class="mb-10">
      <h3 class="mb-4">{t("education")}</h3>
      <ul class="space-y-4">
        {education.map((edu) => (
          <li class="flex flex-col sm:flex-row sm:items-center gap-2 p-4 bg-surface border border-border rounded-xl">
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <h5>{edu.institution}</h5>
                <span class="px-2 py-0.5 text-xs bg-accent-subtle text-accent rounded-full">
                  {edu.status}
                </span>
              </div>
              <p class="text-sm text-text-secondary">{edu.department}</p>
            </div>
            <p class="text-sm text-text-muted whitespace-nowrap">
              {edu.period}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )
}
