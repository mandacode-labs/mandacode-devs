---
import { useTranslations } from "@/lib/i18n/utils";
import { formatMonthYear } from "@/lib/utils/date";
import type { Lang } from "@/types";
import type { UnifiedDeveloper } from "@/lib/content/types";

interface Props {
  developer: UnifiedDeveloper;
  lang: Lang;
}

const { developer, lang } = Astro.props;
const t = useTranslations(lang);

const certifications = developer.certifications;
---

{
  certifications && certifications.length > 0 && (
    <section class="mb-10">
      <h3 class="mb-4">{t("certifications")}</h3>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {certifications.map((cert) => (
          <li class="flex items-center gap-4 p-4 bg-surface border border-border rounded-xl">
            {cert.badge && (
              <img
                src={cert.badge}
                alt={cert.name}
                class="w-16 h-16 object-contain flex-shrink-0"
                loading="lazy"
              />
            )}
            <div class="flex-1 min-w-0">
              <h6 class="mb-1">{cert.name}</h6>
              <p class="text-xs text-text-muted mb-1">{cert.issuer}</p>
              <p class="text-xs text-text-secondary">
                {formatMonthYear(cert.date, lang)}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
