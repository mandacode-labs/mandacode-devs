---
import Card from "@/components/ui/Card.astro";
import FolderIcon from "@/components/icons/Folder.astro";
import UserIcon from "@/components/icons/User.astro";
import BookOpenIcon from "@/components/icons/BookOpen.astro";
import ArrowRightIcon from "@/components/icons/ArrowRight.astro";

type IconName = "folder" | "user" | "bookOpen";

interface Props {
  title: string;
  description: string;
  href: string;
  icon: IconName;
  linkText: string;
}

const iconMap: Record<IconName, typeof FolderIcon> = {
  folder: FolderIcon,
  user: UserIcon,
  bookOpen: BookOpenIcon,
};

const { title, description, href, icon, linkText } = Astro.props;
const IconComponent = iconMap[icon];
---

<Card href={href} class="group h-full">
  <div class="p-6 h-full flex flex-col">
    <div
      class="w-12 h-12 rounded-lg bg-accent-subtle flex items-center justify-center mb-4 group-hover:bg-accent group-hover:text-white transition-colors text-accent"
    >
      <IconComponent size={24} />
    </div>

    <h3 class="text-text-primary mb-2">
      {title}
    </h3>

    <p class="text-sm text-text-secondary mb-4 flex-1">
      {description}
    </p>

    <div class="flex items-center gap-1 text-sm font-medium text-accent">
      <span>{linkText}</span>
      <ArrowRightIcon size={14} />
    </div>
  </div>
</Card>
