---
import { renderTiptapJson } from "@/lib/tiptap/render";
import "highlight.js/styles/atom-one-dark.css";
import "@/components/content-body/content-body.scss";

interface Props {
  content?: string | undefined;
  html?: string | null | undefined;
  class?: string;
}

const { content, html: preHtml, class: className } = Astro.props;

const html = preHtml ?? (content ? renderTiptapJson(content) : null);
---

<div class:list={["max-w-none content-body", className]}>
  {html ? <div set:html={html} /> : null}
</div>

<script>
  import { Copy, Check, createElement } from "lucide";

  const FEEDBACK_DURATION = 1500;

  function setButtonIcon(button: HTMLButtonElement, iconNode: typeof Copy) {
    button.innerHTML = "";
    button.appendChild(createElement(iconNode, { width: 16, height: 16 }));
  }

  function showFeedback(
    el: HTMLElement,
    message: string,
    button?: HTMLButtonElement,
  ) {
    el.setAttribute("aria-label", message);
    if (button) setButtonIcon(button, Check);

    window.setTimeout(() => {
      el.removeAttribute("aria-label");
      if (button) setButtonIcon(button, Copy);
    }, FEEDBACK_DURATION);
  }

  async function copyText(
    text: string,
    trigger: HTMLElement,
    button?: HTMLButtonElement,
  ) {
    try {
      await navigator.clipboard.writeText(text);
      trigger.setAttribute("data-copied", "true");
      showFeedback(trigger, "Copied!", button);
      window.setTimeout(
        () => trigger.removeAttribute("data-copied"),
        FEEDBACK_DURATION,
      );
    } catch {
      showFeedback(trigger, "Copy failed", button);
    }
  }

  function addCopyButton(pre: HTMLPreElement) {
    if (pre.querySelector(".code-copy-button")) return;

    const button = document.createElement("button");
    button.type = "button";
    button.className = "code-copy-button";
    button.setAttribute("aria-label", "Copy code");
    setButtonIcon(button, Copy);

    button.addEventListener("click", () => {
      const code = pre.querySelector("code");
      const text = code ? (code.textContent ?? "") : (pre.textContent ?? "");
      copyText(text, button, button);
    });

    pre.appendChild(button);
  }

  document
    .querySelectorAll<HTMLPreElement>(".content-body pre")
    .forEach(addCopyButton);

  document
    .querySelectorAll<HTMLElement>(".content-body code")
    .forEach((code) => {
      if (code.closest("pre")) return;
      code.classList.add("code-copyable");
      code.addEventListener("click", () => {
        copyText(code.textContent ?? "", code);
      });
    });
</script>
