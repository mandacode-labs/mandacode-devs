---
import {
  SUPPORTED_LANGUAGES,
  DEFAULT_LANGUAGE,
  LANGUAGE_CONFIGS,
} from "@/lib/config/languages";
import { getSiteUrl } from "@/lib/config/site";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  lang?: string;
}

const { title, description, ogImage, canonical, lang } = Astro.props;
const site = Astro.site?.toString() || getSiteUrl();
const currentUrl = new URL(Astro.url.pathname, site).toString();
const currentLang = lang || DEFAULT_LANGUAGE;
const localeConfig = LANGUAGE_CONFIGS[currentLang];

function alternateUrl(targetLang: string): string {
  return new URL(
    Astro.url.pathname.replace(
      new RegExp(`^/(${SUPPORTED_LANGUAGES.join("|")})`),
      `/${targetLang}`,
    ),
    site,
  ).toString();
}
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

{description && <meta name="description" content={description} />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Mandacode Developer" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical || currentUrl} />
{
  localeConfig && (
    <meta
      property="og:locale"
      content={localeConfig.locale.replace("-", "_")}
    />
  )
}
{
  ogImage && (
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{
  ogImage && (
    <meta name="twitter:image" content={new URL(ogImage, site).toString()} />
  )
}

<!-- Canonical -->
<link rel="canonical" href={canonical || currentUrl} />

<!-- Alternate languages -->
{
  [...SUPPORTED_LANGUAGES, "x-default"].map((hreflang) => {
    const targetLang = hreflang === "x-default" ? DEFAULT_LANGUAGE : hreflang;
    return (
      <link
        rel="alternate"
        hreflang={hreflang}
        href={alternateUrl(targetLang)}
      />
    );
  })
}

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
