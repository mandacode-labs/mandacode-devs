---
import { ArrowLeft } from "lucide-react";

interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className = "" } = Astro.props;
---

<a
  href={href}
  class={`inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors mb-8 ${className}`}
>
  <ArrowLeft size={16} className={className} />
  <span>{label}</span>
</a>
