---
import SEO from "@/components/SEO.astro";
import Header from "@/components/layouts/Header.astro";
import Footer from "@/components/layouts/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";
import { getLocaleFromPath } from "@/lib/i18n/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const currentLang = getLocaleFromPath(Astro.url.pathname);
const siteTitle = "Mandacode Developer";
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <SEO title={pageTitle} description={description} ogImage={ogImage} />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <style is:global>
      /* Disable view transition animations */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation: none;
        mix-blend-mode: normal;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col bg-bg-primary">
    <Header currentLang={currentLang} class="print:hidden" />
    <main class="flex-1">
      <slot />
    </main>
    <Footer currentLang={currentLang} class="print:hidden" />
  </body>
</html>
