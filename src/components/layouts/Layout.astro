---
import SEO from "@/components/SEO.astro";
import Header from "@/components/layouts/Header.astro";
import Footer from "@/components/layouts/Footer.astro";
import "@/styles/global.css";
import { getLocaleFromPath } from "@/lib/i18n/utils";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const currentLang = getLocaleFromPath(Astro.url.pathname);
const siteTitle = "Mandacode Developer";
const pageTitle = title ? `${title} | ${siteTitle}` : siteTitle;
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <SEO title={pageTitle} description={description} ogImage={ogImage} />

    <!-- External domain preconnect -->
    <link rel="preconnect" href="https://static.mandacode.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-bg-primary">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-lg"
    >
      Skip to main content
    </a>
    <Header currentLang={currentLang} class="print:hidden" />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer currentLang={currentLang} class="print:hidden" />
  </body>
</html>
