---
import AdminPageLayout from "@/components/admin/AdminPageLayout.astro";
import AdminCard from "@/components/admin/AdminCard.astro";
import Icon from "@/components/icons/Icon.astro";
import { ArrowLeft, Eye } from "lucide-react";

interface Props {
  title: string;
  headerTitle: string;
  headerSubtitle?: string;
  backHref: string;
  backLabel: string;
  currentPath: string;
  viewHref?: string;
  viewLabel?: string;
}

const {
  title,
  headerTitle,
  headerSubtitle,
  backHref,
  backLabel,
  currentPath,
  viewHref,
  viewLabel,
} = Astro.props;
---

<AdminPageLayout
  title={title}
  headerTitle={headerTitle}
  headerSubtitle={headerSubtitle}
  currentPath={currentPath}
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-6 flex items-center justify-between">
      <a
        href={backHref}
        class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors"
      >
        <Icon icon={ArrowLeft} class="w-4 h-4" />
        {backLabel}
      </a>
      {
        viewHref && (
          <a
            href={viewHref}
            target="_blank"
            class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover transition-colors"
          >
            <Icon icon={Eye} class="w-4 h-4" />
            {viewLabel ?? "View"}
          </a>
        )
      }
    </div>

    <AdminCard class="p-4 sm:p-6 lg:p-8">
      <slot />
    </AdminCard>
  </div>
</AdminPageLayout>
