---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import AdminCard from "@/components/admin/AdminCard.astro";

interface Props {
  title: string;
  headerTitle: string;
  headerSubtitle?: string;
  backHref: string;
  backLabel: string;
  currentPath: string;
  viewHref?: string;
  viewLabel?: string;
}

const {
  title,
  headerTitle,
  headerSubtitle,
  backHref,
  backLabel,
  currentPath,
  viewHref,
  viewLabel,
} = Astro.props;
---

<AdminLayout title={title}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={currentPath} />

    <div class="flex-1 md:ml-64">
      <AdminHeader title={headerTitle} subtitle={headerSubtitle} />

      <main class="p-4 sm:p-6 lg:p-8">
        <div class="max-w-4xl mx-auto">
          <div class="mb-6 flex items-center justify-between">
            <a
              href={backHref}
              class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
              </svg>
              {backLabel}
            </a>
            {
              viewHref && (
                <a
                  href={viewHref}
                  target="_blank"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover transition-colors"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    class="w-4 h-4"
                  >
                    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                  {viewLabel ?? "View"}
                </a>
              )
            }
          </div>

          <AdminCard class="p-6">
            <slot />
          </AdminCard>
        </div>
      </main>
    </div>
  </div>
</AdminLayout>
