---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { useTranslations } from "@/lib/i18n/utils";
import type { Lang } from "@/types";
import type { PublishStatus } from "@/lib/db/schema";

interface Props {
  title: string;
  headerTitle: string;
  headerSubtitle?: string;
  backHref: string;
  backLabel: string;
  currentPath: string;
  lang: Lang;
  locale: string;
  originalLocale: string;
  publishStatus: PublishStatus;
  isFallback: boolean;
}

const {
  title,
  headerTitle,
  headerSubtitle,
  backHref,
  backLabel,
  currentPath,
  lang,
  locale,
  originalLocale,
  publishStatus,
  isFallback,
} = Astro.props;

const t = useTranslations(lang);
const statusLabel = t(`admin.${publishStatus}` as const);
---

<AdminLayout title={title}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={currentPath} />

    <div class="flex-1 md:ml-64">
      <AdminHeader title={headerTitle} subtitle={headerSubtitle} />

      <main class="p-4 sm:p-6 lg:p-8">
        <div class="max-w-4xl mx-auto">
          <div class="mb-6">
            <a
              href={backHref}
              class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
              </svg>
              {backLabel}
            </a>
          </div>

          <div
            class="mb-6 rounded-lg border border-yellow-200 bg-yellow-50 px-4 py-3 text-sm text-yellow-800"
          >
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              <span class="inline-flex items-center gap-1.5 font-semibold">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="w-4 h-4"
                >
                  <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
                {t("admin.previewMode")}
              </span>
              <span>
                {t("admin.locale")}: <strong class="uppercase">{locale}</strong>
              </span>
              <span>
                {t("admin.status")}: <strong>{statusLabel}</strong>
              </span>
              {
                isFallback && (
                  <span class="w-full text-yellow-700">
                    {t("admin.fallbackPreview", {
                      locale: locale.toUpperCase(),
                      originalLocale: originalLocale.toUpperCase(),
                    })}
                  </span>
                )
              }
            </div>
          </div>

          <slot />
        </div>
      </main>
    </div>
  </div>
</AdminLayout>
