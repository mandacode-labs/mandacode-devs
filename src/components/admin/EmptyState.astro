---
interface Props {
  title: string;
  message?: string;
}

const { title, message = "No items found" } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-16 px-4 text-center">
  <div
    class="w-12 h-12 rounded-xl bg-bg-tertiary flex items-center justify-center mb-4"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      class="w-6 h-6 text-text-muted"
    >
      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
      <line x1="9" y1="9" x2="15" y2="9"></line>
      <line x1="9" y1="13" x2="15" y2="13"></line>
      <line x1="9" y1="17" x2="11" y2="17"></line>
    </svg>
  </div>
  <h3 class="text-base font-semibold text-text-primary mb-1">{title}</h3>
  <p class="text-sm text-text-secondary">{message}</p>
</div>
