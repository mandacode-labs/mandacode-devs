---
import { type Lang } from "@/lib/i18n/utils";
import { SUPPORTED_LANGUAGES, LANGUAGE_CONFIGS } from "@/lib/config/languages";

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;

const currentPath = Astro.url.pathname;

function getLocaleUrl(pathname: string, lang: Lang): string {
  const hasLangPrefix = SUPPORTED_LANGUAGES.some(
    (l) => pathname.startsWith(`/${l}/`) || pathname === `/${l}`,
  );
  if (hasLangPrefix) {
    return pathname.replace(
      new RegExp(`^/(${SUPPORTED_LANGUAGES.join("|")})`),
      `/${lang}`,
    );
  }
  return `/${lang}${pathname}`;
}

const otherLangs = SUPPORTED_LANGUAGES.filter((lang) => lang !== currentLang);
---

<div class="relative" data-language-switcher>
  <button
    type="button"
    class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-text-secondary hover:text-text-primary transition-colors rounded-md hover:bg-bg-secondary"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={`Current language: ${LANGUAGE_CONFIGS[currentLang].label}. Change language`}
    data-switcher-button
  >
    <span>{LANGUAGE_CONFIGS[currentLang].label}</span>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="transition-transform"
      aria-hidden="true"
      data-chevron
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    class="absolute right-0 top-full mt-1 py-1 bg-bg-primary border border-border rounded-lg shadow-lg opacity-0 invisible transition-all min-w-[140px] z-50"
    role="listbox"
    aria-label="Select language"
    data-switcher-menu
  >
    {
      otherLangs.map((lang) => (
        <a
          href={getLocaleUrl(currentPath, lang)}
          role="option"
          class="block px-4 py-2 text-sm text-text-secondary hover:text-text-primary hover:bg-bg-secondary transition-colors"
        >
          {LANGUAGE_CONFIGS[lang].label}
        </a>
      ))
    }
  </div>
</div>

<style>
  [data-switcher-button]:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-accent);
  }
</style>

<script>
  class LanguageSwitcher {
    #el;
    #button;
    #menu;
    #chevron;
    #items;
    #isOpen = false;

    constructor(el: HTMLElement) {
      this.#el = el;
      this.#button = el.querySelector<HTMLButtonElement>(
        "[data-switcher-button]",
      )!;
      this.#menu = el.querySelector<HTMLElement>("[data-switcher-menu]")!;
      this.#chevron = el.querySelector<HTMLElement>("[data-chevron]")!;
      this.#items = [
        ...this.#menu.querySelectorAll("a[role=option]"),
      ] as HTMLAnchorElement[];

      this.#button.addEventListener("click", () => this.#toggle());
      this.#button.addEventListener("keydown", (e: KeyboardEvent) =>
        this.#onButtonKey(e),
      );
      this.#menu.addEventListener("keydown", (e: KeyboardEvent) =>
        this.#onMenuKey(e),
      );
      document.addEventListener("click", (e: MouseEvent) => {
        const target = e.target as Node;
        if (!this.#el.contains(target)) this.#close();
      });
      document.addEventListener("focusin", (e: FocusEvent) => {
        const target = e.target as Node;
        if (!this.#el.contains(target)) this.#close();
      });
    }

    #toggle() {
      if (this.#isOpen) {
        this.#close();
      } else {
        this.#openMenu();
        this.#button.focus();
      }
    }

    #openMenu() {
      this.#isOpen = true;
      this.#button.setAttribute("aria-expanded", "true");
      this.#menu.classList.remove("opacity-0", "invisible");
      this.#chevron?.classList.add("rotate-180");
    }

    #close() {
      this.#isOpen = false;
      this.#button.setAttribute("aria-expanded", "false");
      this.#menu.classList.add("opacity-0", "invisible");
      this.#chevron?.classList.remove("rotate-180");
    }

    #onButtonKey(e: KeyboardEvent) {
      if (e.key === "Escape") {
        e.preventDefault();
        this.#close();
        return;
      }
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        this.#toggle();
        return;
      }
      if (e.key === "ArrowDown") {
        e.preventDefault();
        if (!this.#isOpen) this.#openMenu();
        this.#items[0]?.focus();
        return;
      }
      if (e.key === "ArrowUp") {
        e.preventDefault();
        if (!this.#isOpen) {
          this.#openMenu();
          this.#items[this.#items.length - 1]?.focus();
        } else {
          this.#items[this.#items.length - 1]?.focus();
        }
        return;
      }
    }

    #onMenuKey(e: KeyboardEvent) {
      const target = e.target as HTMLAnchorElement;
      if (e.key === "Escape") {
        e.preventDefault();
        this.#close();
      }
      if (e.key === "ArrowDown") {
        e.preventDefault();
        const idx = this.#items.indexOf(target);
        this.#items[(idx + 1) % this.#items.length]?.focus();
      }
      if (e.key === "ArrowUp") {
        e.preventDefault();
        const idx = this.#items.indexOf(target);
        this.#items[
          (idx - 1 + this.#items.length) % this.#items.length
        ]?.focus();
      }
    }
  }

  for (const el of document.querySelectorAll<HTMLElement>(
    "[data-language-switcher]",
  )) {
    new LanguageSwitcher(el);
  }

  function setLanguageCookie(lang: string) {
    const maxAge = 60 * 60 * 24 * 365;
    document.cookie = `lang=${lang}; Path=/; Max-Age=${maxAge}; SameSite=Lax; Secure`;
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>(
    "[data-language-switcher] a[role=option]",
  )) {
    link.addEventListener("click", () => {
      const lang = link.getAttribute("href")?.split("/")[1];
      if (lang) setLanguageCookie(lang);
    });
  }
</script>
