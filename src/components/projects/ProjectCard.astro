---
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import CoverImage from "@/components/ui/CoverImage.astro";
import { useTranslations } from "@/lib/i18n/utils";
import type { Lang } from "@/types";
import type { UnifiedProject } from "@/lib/content/types";
import type { UIKey } from "@/lib/i18n";

interface Props {
  project: UnifiedProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const title = project.title;
const description = project.description;
const coverImage = project.coverImage;
const statusKey = `status.${project.status}` as UIKey;
const slug = project.id;
---

<Card href={`/${lang}/projects/${slug}`} class="group">
  <div class="flex flex-col sm:flex-row">
    <div class="sm:w-48 md:w-56 flex-shrink-0">
      {
        coverImage ? (
          <CoverImage
            src={coverImage}
            alt={title}
            class="flex aspect-video sm:aspect-square rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none"
          />
        ) : (
          <div class="aspect-video sm:aspect-square relative overflow-hidden rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none bg-bg-secondary bg-gradient-to-br from-surface to-border flex items-center justify-center">
            <span class="text-text-muted text-sm font-medium">{title}</span>
          </div>
        )
      }
    </div>

    <div class="flex-1 p-4 sm:p-5 flex flex-col">
      <div class="flex items-start justify-between gap-2 mb-2">
        <h4 class="text-text-primary group-hover:text-accent transition-colors">
          {title}
        </h4>
        <Badge variant="status" status={project.status}>{t(statusKey)}</Badge>
      </div>

      <p class="text-sm text-text-secondary line-clamp-2 mb-3">
        {description}
      </p>

      <div class="flex items-center gap-1.5 flex-wrap mt-auto">
        {project.tags.map((tag) => <Badge variant="tech">{tag}</Badge>)}
      </div>
    </div>
  </div>
</Card>
