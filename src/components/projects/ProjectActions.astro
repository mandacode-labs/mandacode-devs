---
import { ExternalLink, BookOpen } from "lucide-react";
import Button from "@/components/ui/Button.astro";
import GithubIcon from "@/components/icons/Github.astro";
import { useTranslations } from "@/lib/i18n/utils";
import type { Lang } from "@/types";
import type { UnifiedProject } from "@/lib/content/types";

interface Props {
  project: UnifiedProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const blogHref = project.blogPostId
  ? `/${lang}/blog/${project.blogPostId}`
  : project.blogUrl;
---

<div class="flex flex-wrap items-center gap-3">
  {
    project.url && (
      <Button href={project.url} variant="primary">
        <span>{t("projects.visitSite")}</span>
        <ExternalLink size={16} />
      </Button>
    )
  }
  {
    project.sourceUrl && (
      <Button href={project.sourceUrl} variant="secondary">
        <GithubIcon size={16} />
        <span>Source</span>
      </Button>
    )
  }
  {
    blogHref && (
      <Button href={blogHref} variant="secondary">
        <BookOpen size={16} />
        <span>Blog</span>
      </Button>
    )
  }
</div>
