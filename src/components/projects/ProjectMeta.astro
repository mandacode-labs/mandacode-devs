---
import Badge from "@/components/ui/Badge.astro";
import { useTranslations } from "@/lib/i18n/utils";
import type { Lang } from "@/types";
import type { UnifiedProject } from "@/lib/content/types";
import type { UIKey } from "@/lib/i18n";

interface Props {
  project: UnifiedProject;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const statusKey = `status.${project.status}` as UIKey;
---

<header class="mb-6">
  <div class="flex items-center gap-3 mb-3">
    <h2>{project.title}</h2>
    <Badge variant="status" status={project.status}>{t(statusKey)}</Badge>
  </div>
  <p class="text-lg text-text-secondary">{project.description}</p>
</header>

<section class="mb-8">
  <h6 class="text-text-muted uppercase tracking-wider mb-3">
    {t("techStack")}
  </h6>
  <div class="flex flex-wrap gap-2">
    {project.techStack.map((tech) => <Badge variant="tech">{tech}</Badge>)}
  </div>
</section>

<section class="mb-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
  <div>
    <h6 class="text-text-muted uppercase tracking-wider mb-2">
      {t("duration")}
    </h6>
    <p class="text-text-primary">{project.duration}</p>
  </div>
  <div>
    <h6 class="text-text-muted uppercase tracking-wider mb-2">
      {t("teamSize")}
    </h6>
    <p class="text-text-primary">
      {project.teamSize}
      {t("teamSize.unit")}
    </p>
  </div>
  <div>
    <h6 class="text-text-muted uppercase tracking-wider mb-2">
      {t("role")}
    </h6>
    <p class="text-text-primary">{project.role}</p>
  </div>
</section>
