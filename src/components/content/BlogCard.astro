---
import type { CollectionEntry } from "astro:content";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import ImagePlaceholder from "../icons/ImagePlaceholder.astro";
import type { Lang } from "@/lib/i18n/utils";
import { formatDate } from "@/lib/utils/date";

interface Props {
  post: CollectionEntry<"blog">;
  lang: Lang;
}

const { post, lang } = Astro.props;

const title = post.data.title;
const description = post.data.description;
---

<Card href={`/${lang}/blog/${post.id.split("/").pop()}`} class="group">
  <div class="flex flex-col sm:flex-row">
    <div class="sm:w-48 md:w-56 flex-shrink-0">
      <div
        class="relative aspect-video sm:aspect-square overflow-hidden rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none bg-bg-secondary flex items-center justify-center"
      >
        {
          post.data.coverImage ? (
            <>
              <div class="shimmer absolute inset-0 z-10" />
              <img
                src={post.data.coverImage}
                alt={title}
                class="relative w-full !h-full object-cover opacity-0 transition-all duration-300 group-hover:scale-105"
                style="z-index: 11;"
                loading="lazy"
                decoding="async"
                width="224"
                height="224"
                onload="this.style.opacity='1'; this.previousElementSibling.style.display='none'"
              />
            </>
          ) : (
            <div class="w-full h-full flex items-center justify-center text-text-muted">
              <ImagePlaceholder />
            </div>
          )
        }
      </div>
    </div>

    <div class="flex-1 p-4 sm:p-5 flex flex-col">
      <div class="flex items-start justify-between gap-2 mb-2">
        <h4 class="text-text-primary group-hover:text-accent transition-colors">
          {title}
        </h4>
      </div>

      <p class="text-sm text-text-secondary line-clamp-2 mb-3">
        {description}
      </p>

      <div class="flex items-center gap-2 mt-auto">
        <time class="text-xs text-text-muted"
          >{formatDate(post.data.pubDate, lang)}</time
        >
        <span class="text-text-muted">·</span>
        <div class="flex items-center gap-1.5">
          {
            post.data.tags
              .slice(0, 3)
              .map((tag) => <Badge variant="default">{tag}</Badge>)
          }
        </div>
      </div>
    </div>
  </div>
</Card>
