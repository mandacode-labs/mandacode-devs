---
import type { CollectionEntry } from "astro:content";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const title = lang === "ko" ? project.data.title : project.data.title_en;
const description = lang === "ko" ? project.data.description : project.data.description_en;
const image = project.data.coverImage || project.data.ogImage || "/og-cache/fallback.jpg";
const statusKey = `status.${project.data.status}` as const;
---

<Card href={`/${lang}/projects/${project.slug}`} class="group">
  <div class="flex flex-col sm:flex-row">
    <!-- Thumbnail -->
    <div class="sm:w-48 md:w-56 flex-shrink-0">
      <div class="aspect-video sm:aspect-square overflow-hidden rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none bg-bg-secondary">
        <img 
          src={image} 
          alt={title}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    </div>
    
    <!-- Content -->
    <div class="flex-1 p-4 sm:p-5 flex flex-col">
      <div class="flex items-start justify-between gap-2 mb-2">
        <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
          {title}
        </h3>
        <Badge variant="status">{t(statusKey)}</Badge>
      </div>
      
      <p class="text-sm text-text-secondary line-clamp-2 mb-3">
        {description}
      </p>
      
      <div class="flex items-center gap-1.5 flex-wrap mt-auto">
        {project.data.techStack.map((tech) => (
          <Badge variant="tech">{tech}</Badge>
        ))}
      </div>
    </div>
  </div>
</Card>
