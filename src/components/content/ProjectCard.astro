---
import type { CollectionEntry } from "astro:content";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import { useTranslations, type Lang } from "@/i18n/utils";
import { getImageUrl } from "@/lib/images";

interface Props {
  project: CollectionEntry<"projects">;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);

const title = project.data.title;
const description = project.data.description;
const coverImage = project.data.coverImage ? getImageUrl(project.data.coverImage) : null;
const statusKey = `status.${project.data.status}` as const;
---

<Card href={`/${lang}/projects/${project.id.split("/").pop()}`} class="group">
  <div class="flex flex-col sm:flex-row">
    <div class="sm:w-48 md:w-56 flex-shrink-0">
      <div
        class="aspect-video sm:aspect-square overflow-hidden rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none bg-bg-secondary flex items-center justify-center"
      >
        {
          coverImage ? (
            <img
              src={coverImage}
              alt={title}
              class="w-full h-full! object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-br from-surface to-border flex items-center justify-center">
              <span class="text-text-muted text-sm font-medium">{title}</span>
            </div>
          )
        }
      </div>
    </div>

    <div class="flex-1 p-4 sm:p-5 flex flex-col">
      <div class="flex items-start justify-between gap-2 mb-2">
        <h4
          class="text-text-primary group-hover:text-accent transition-colors"
        >
          {title}
        </h4>
        <Badge variant="status" status={project.data.status}
          >{t(statusKey)}</Badge
        >
      </div>

      <p class="text-sm text-text-secondary line-clamp-2 mb-3">
        {description}
      </p>

      <div class="flex items-center gap-1.5 flex-wrap mt-auto">
        {
          project.data.techStack.map((tech) => (
            <Badge variant="tech">{tech}</Badge>
          ))
        }
      </div>
    </div>
  </div>
</Card>
