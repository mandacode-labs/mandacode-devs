---
import type { CollectionEntry } from "astro:content";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import Icon from "../ui/Icon.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

interface Props {
  developer: CollectionEntry<"developers">;
  lang: Lang;
}

const { developer, lang } = Astro.props;
const t = useTranslations(lang);

const name = lang === "ko" ? developer.data.name : developer.data.name_en;
const role = lang === "ko" ? developer.data.role : developer.data.role_en;
const bio = lang === "ko" ? developer.data.bio : developer.data.bio_en;
const avatar = developer.data.avatar || "https://github.com/github.png";
---

<Card href={`/${lang}/developers/${developer.slug}`} class="group">
  <div class="p-5 flex items-start gap-4">
    <!-- Avatar -->
    <div class="flex-shrink-0">
      <img 
        src={avatar} 
        alt={name}
        class="w-16 h-16 rounded-full object-cover border-2 border-border group-hover:border-accent transition-colors"
        loading="lazy"
      />
    </div>
    
    <!-- Info -->
    <div class="flex-1 min-w-0">
      <h3 class="text-lg font-semibold text-text-primary group-hover:text-accent transition-colors">
        {name}
      </h3>
      
      <p class="text-sm text-accent font-medium mb-2">{role}</p>
      
      <p class="text-sm text-text-secondary line-clamp-2">{bio}</p>
      
      <div class="flex items-center gap-3 mt-3">
        {developer.data.github && (
          <a 
            href={developer.data.github} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text-primary transition-colors"
            onclick="event.stopPropagation()"
          >
            <Icon name="github" size={16} />
          </a>
        )}
        {developer.data.email && (
          <a 
            href={`mailto:${developer.data.email}`}
            class="text-text-muted hover:text-text-primary transition-colors"
            onclick="event.stopPropagation()"
          >
            <Icon name="mail" size={16} />
          </a>
        )}
        {developer.data.website && (
          <a 
            href={developer.data.website} 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-text-muted hover:text-text-primary transition-colors"
            onclick="event.stopPropagation()"
          >
            <Icon name="globe" size={16} />
          </a>
        )}
      </div>
    </div>
  </div>
</Card>
