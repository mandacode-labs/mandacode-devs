---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from "@/lib/config/languages";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const { title, description, ogImage, canonical } = Astro.props;
const site = Astro.site?.toString() || "https://dev.mandacode.com";
const currentUrl = new URL(Astro.url.pathname, site).toString();
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

{description && <meta name="description" content={description} />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Mandacode Developer" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical || currentUrl} />
{
  ogImage && (
    <meta property="og:image" content={new URL(ogImage, site).toString()} />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{
  ogImage && (
    <meta name="twitter:image" content={new URL(ogImage, site).toString()} />
  )
}

<!-- Canonical -->
<link rel="canonical" href={canonical || currentUrl} />

<!-- Alternate languages -->
{
  SUPPORTED_LANGUAGES.map((lang) => (
    <link
      rel="alternate"
      hreflang={lang}
      href={new URL(
        Astro.url.pathname.replace(
          new RegExp(`^/(${SUPPORTED_LANGUAGES.join("|")})/`),
          `/${lang}/`,
        ),
        site,
      ).toString()}
    />
  ))
}
<link
  rel="alternate"
  hreflang="x-default"
  href={new URL(
    Astro.url.pathname.replace(
      new RegExp(`^/(${SUPPORTED_LANGUAGES.join("|")})/`),
      `/${DEFAULT_LANGUAGE}/`,
    ),
    site,
  ).toString()}
/>

<!-- Favicon -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="shortcut icon" href="/favicon.ico" />
