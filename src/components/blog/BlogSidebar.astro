---
import { Home } from "lucide-react";
import type { Lang } from "@/types";
import { useTranslations } from "@/lib/i18n/utils";
import {
  buildPostTree,
  isPathActive,
  type PostPath,
} from "@/lib/content/post-tree";
import FolderItem from "@/components/blog/FolderItem.astro";

interface Props {
  lang: Lang;
  currentPath: string;
  paths: PostPath[];
}

const { lang, currentPath, paths } = Astro.props;
const t = useTranslations(lang);
const tree = buildPostTree(paths);
const rootActive = isPathActive(currentPath, "/");
---

<aside class="text-sm">
  <nav aria-label={t("blog.sidebar")}>
    <a
      href={`/${lang}/blog`}
      aria-current={rootActive ? "page" : undefined}
      class={`flex items-center gap-2 px-3 py-1.5 rounded-md transition-colors ${
        rootActive
          ? "text-accent font-medium bg-accent-subtle"
          : "text-text-secondary hover:bg-bg-secondary hover:text-text-primary"
      }`}
    >
      <Home
        size={14}
        className={rootActive ? "text-accent" : "text-text-muted"}
      />
      <span>{t("blog.allPosts")}</span>
    </a>

    {
      tree.length > 0 && (
        <ul class="mt-3 space-y-0.5">
          {tree.map((node) => (
            <FolderItem
              node={node}
              lang={lang}
              currentPath={currentPath}
              depth={1}
            />
          ))}
        </ul>
      )
    }
  </nav>
</aside>
