---
import Badge from "@/components/ui/Badge.astro";
import { formatDate } from "@/lib/utils/date";
import type { Lang } from "@/types";
import type { UnifiedPost } from "@/lib/content/types";

interface Props {
  post: UnifiedPost;
  lang: Lang;
}

const { post, lang } = Astro.props;
---

<header class="mb-8">
  <div class="flex items-center gap-2 mb-4">
    <time class="text-sm text-text-muted">{formatDate(post.pubDate, lang)}</time
    >
    <span class="text-text-muted">·</span>
    <div class="flex items-center gap-1.5">
      {post.tags.map((tag) => <Badge variant="default">{tag}</Badge>)}
    </div>
  </div>

  <h2>{post.title}</h2>
  <p class="text-lg text-text-secondary mt-4">{post.description}</p>
</header>
