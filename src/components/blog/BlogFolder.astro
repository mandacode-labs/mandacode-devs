---
import Layout from "@/components/layouts/Layout.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import BlogSidebar from "@/components/blog/BlogSidebar.astro";
import { useTranslations } from "@/lib/i18n/utils";
import type { Lang } from "@/types";
import type { UnifiedPost } from "@/lib/content/types";

interface PostPath {
  path: string;
  count: number;
}

interface Props {
  lang: Lang;
  folderPath: string;
  folderLabel: string;
  posts: UnifiedPost[];
  paths: PostPath[];
}

const { lang, folderPath, folderLabel, posts, paths } = Astro.props;
const t = useTranslations(lang);
---

<Layout title={`${folderLabel} · ${t("blog.title")}`}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <nav class="mb-4 text-sm text-text-secondary">
      <a href={`/${lang}/blog`} class="hover:text-text-primary">
        {t("blog.title")}
      </a>
      {
        folderPath !== "/" && (
          <>
            <span class="mx-2">/</span>
            <span class="font-mono text-text-primary">{folderPath}</span>
          </>
        )
      }
    </nav>

    <header class="mb-8">
      <h2 class="mb-2 font-mono">{folderLabel}</h2>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-[14rem_1fr] gap-8">
      <BlogSidebar lang={lang} currentPath={folderPath} paths={paths} />

      <div>
        {
          posts.length > 0 ? (
            <ul class="flex flex-col gap-6">
              {posts.map((post) => (
                <li>
                  <BlogCard post={post} lang={lang} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-text-secondary py-12 text-center">
              {t("blog.emptyFolder")}
            </p>
          )
        }
      </div>
    </div>
  </section>
</Layout>
