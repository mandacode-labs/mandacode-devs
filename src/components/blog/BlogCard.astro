---
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import CoverImage from "@/components/ui/CoverImage.astro";
import ImagePlaceholder from "@/components/icons/ImagePlaceholder.astro";
import type { Lang } from "@/types";
import { formatDate } from "@/lib/utils/date";
import type { UnifiedPost } from "@/lib/content/types";

interface Props {
  post: UnifiedPost;
  lang: Lang;
}

const { post, lang } = Astro.props;

const title = post.title;
const description = post.description;
const slug = post.id;
const coverImage = post.coverImage;
const pubDate = post.pubDate;
const tags = post.tags;
---

<Card href={`/${lang}/blog/${slug}`} class="group">
  <div class="flex flex-col sm:flex-row">
    <div class="sm:w-48 md:w-56 flex-shrink-0">
      {
        coverImage ? (
          <CoverImage
            src={coverImage}
            alt={title}
            class="flex aspect-video sm:aspect-square rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none"
          />
        ) : (
          <div class="aspect-video sm:aspect-square relative overflow-hidden rounded-t-xl sm:rounded-l-xl sm:rounded-tr-none bg-bg-secondary flex items-center justify-center text-text-muted">
            <ImagePlaceholder />
          </div>
        )
      }
    </div>

    <div class="flex-1 p-4 sm:p-5 flex flex-col">
      <div class="flex items-start justify-between gap-2 mb-2">
        <h4 class="text-text-primary group-hover:text-accent transition-colors">
          {title}
        </h4>
      </div>

      <p class="text-sm text-text-secondary line-clamp-2 mb-3">
        {description}
      </p>

      <div class="flex items-center gap-2 mt-auto">
        <time class="text-xs text-text-muted">{formatDate(pubDate, lang)}</time>
        <span class="text-text-muted">·</span>
        <div class="flex items-center gap-1.5">
          {
            tags
              .slice(0, 3)
              .map((tag) => <Badge variant="default">{tag}</Badge>)
          }
        </div>
      </div>
    </div>
  </div>
</Card>
