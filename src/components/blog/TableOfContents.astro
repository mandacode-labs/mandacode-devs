---
import type { HeadingInfo } from "@/lib/tiptap/render";

interface Props {
  headings: HeadingInfo[];
}

const { headings } = Astro.props;

if (headings.length < 3) return null;

function indentClass(level: number): string {
  if (level <= 1) return "pl-0";
  if (level === 2) return "pl-3";
  return "pl-6";
}
---

<aside
  class="hidden lg:block absolute top-32 left-full ml-10 w-56"
  aria-label="Table of contents"
>
  <nav class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto text-sm">
    <p
      class="text-xs font-medium text-text-muted uppercase tracking-wider mb-3"
    >
      On this page
    </p>
    <ul class="space-y-1 border-l border-border">
      {
        headings.map((h) => (
          <li>
            <a
              href={`#${h.id}`}
              data-toc-link={h.id}
              data-active="false"
              class={`block ${indentClass(h.level)} -ml-px py-1 pl-3 border-l-2 border-transparent text-text-secondary hover:text-text-primary hover:border-text-muted transition-colors data-[active=true]:text-accent data-[active=true]:font-medium data-[active=true]:border-accent`}
            >
              {h.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script is:inline>
  (() => {
    const links = document.querySelectorAll("[data-toc-link]");
    if (links.length === 0) return;
    const ids = Array.from(links).map((a) => a.getAttribute("data-toc-link"));
    const headings = ids
      .map((id) => document.getElementById(id))
      .filter(Boolean);
    if (headings.length === 0) return;

    const setActive = (id) => {
      links.forEach((a) => {
        a.dataset.active =
          a.getAttribute("data-toc-link") === id ? "true" : "false";
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length > 0) {
          setActive(visible[0].target.id);
        }
      },
      { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
    );
    headings.forEach((h) => observer.observe(h));

    links.forEach((a) => {
      a.addEventListener("click", (e) => {
        const id = a.getAttribute("data-toc-link");
        const target = id ? document.getElementById(id) : null;
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: "smooth", block: "start" });
          history.replaceState(null, "", `#${id}`);
          setActive(id);
        }
      });
    });
  })();
</script>
