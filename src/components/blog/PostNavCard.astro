---
import { ArrowLeft, ArrowRight } from "lucide-react";
import { formatDate } from "@/lib/utils/date";
import type { Lang } from "@/types";
import type { UnifiedPost } from "@/lib/content/types";

interface Props {
  prev: UnifiedPost | null;
  next: UnifiedPost | null;
  lang: Lang;
  prevLabel: string;
  nextLabel: string;
}

const { prev, next, lang, prevLabel, nextLabel } = Astro.props;
---

{
  (prev || next) && (
    <nav
      class="grid grid-cols-1 sm:grid-cols-2 gap-3"
      aria-label="Post navigation"
    >
      {prev ? (
        <a
          href={`/${lang}/blog/${prev.id}`}
          class="group flex items-center gap-3 px-4 py-3 rounded-lg border border-border bg-bg-secondary/40 hover:bg-bg-secondary hover:border-border-hover transition-colors text-left"
        >
          <ArrowLeft size={16} className="text-text-muted shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="text-xs text-text-muted">{prevLabel}</p>
            <p class="text-sm font-medium text-text-primary group-hover:text-accent truncate transition-colors">
              {prev.title}
            </p>
            <p class="text-xs text-text-muted mt-0.5">
              {formatDate(prev.pubDate, lang)}
            </p>
          </div>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
      {next ? (
        <a
          href={`/${lang}/blog/${next.id}`}
          class="group flex items-center gap-3 px-4 py-3 rounded-lg border border-border bg-bg-secondary/40 hover:bg-bg-secondary hover:border-border-hover transition-colors text-right sm:order-last"
        >
          <div class="min-w-0 flex-1">
            <p class="text-xs text-text-muted">{nextLabel}</p>
            <p class="text-sm font-medium text-text-primary group-hover:text-accent truncate transition-colors">
              {next.title}
            </p>
            <p class="text-xs text-text-muted mt-0.5">
              {formatDate(next.pubDate, lang)}
            </p>
          </div>
          <ArrowRight size={16} className="text-text-muted shrink-0" />
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
    </nav>
  )
}
