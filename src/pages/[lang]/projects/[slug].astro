---
import Layout from "@/components/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  const paths = [];
  for (const project of projects) {
    const slug = project.id.split("/").pop();
    paths.push({ params: { lang: project.data.lang, slug } });
  }
  return paths;
}

const { lang, slug } = Astro.params;
const t = useTranslations(lang as Lang);

const projects = await getCollection(
  "projects",
  (p) => p.data.lang === lang && p.id.endsWith(`/${slug}`),
);
const project = projects[0];

if (!project) {
  return Astro.redirect(`/${lang}/projects`);
}

const title = project.data.title;
const description = project.data.description;
const coverImage = project.data.coverImage;
const statusKey = `status.${project.data.status}` as const;

const { Content } = await render(project);
---

<Layout title={title} description={description} ogImage={coverImage}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <a
      href={`/${lang}/projects`}
      class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="rotate-180"
        ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
      >
      <span>{t("projects.title")}</span>
    </a>

    <div
      class="flex w-full max-h-[30rem]! justify-center mb-8 bg-bg-secondary rounded-lg overflow-hidden"
    >
      {
        coverImage ? (
          <img
            src={coverImage}
            alt={title}
            class="w-full h-full object-contain"
          />
        ) : (
          <div class="w-full h-full bg-gradient-to-br from-surface to-border flex items-center justify-center">
            <span class="text-text-muted text-xl font-medium">{title}</span>
          </div>
        )
      }
    </div>

    <header class="mb-6">
      <div class="flex items-center gap-3 mb-3">
        <h2>{title}</h2>
        <Badge variant="status" status={project.data.status}
          >{t(statusKey)}</Badge
        >
      </div>
      <p class="text-lg text-text-secondary">{description}</p>
    </header>

    <section class="mb-8">
      <h6 class="text-text-muted uppercase tracking-wider mb-3">
        {t("techStack")}
      </h6>
      <div class="flex flex-wrap gap-2">
        {
          project.data.techStack.map((tech) => (
            <Badge variant="tech">{tech}</Badge>
          ))
        }
      </div>
    </section>

    <section class="mb-8 grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <h6 class="text-text-muted uppercase tracking-wider mb-2">
          {t("duration")}
        </h6>
        <p class="text-text-primary">{project.data.duration}</p>
      </div>
      <div>
        <h6 class="text-text-muted uppercase tracking-wider mb-2">
          {t("teamSize")}
        </h6>
        <p class="text-text-primary">
          {project.data.teamSize}
          {lang === "ko" ? "명" : ""}
        </p>
      </div>
      <div>
        <h6 class="text-text-muted uppercase tracking-wider mb-2">
          {t("role")}
        </h6>
        <p class="text-text-primary">{project.data.role}</p>
      </div>
    </section>

    <div class="prose prose-neutral max-w-none mb-8">
      <Content />
    </div>

    <div class="flex flex-wrap items-center gap-3">
      {
        project.data.url && (
          <Button href={project.data.url} variant="primary">
            <span>{t("projects.visitSite")}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 3h6v6" />
              <path d="M10 14 21 3" />
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
          </Button>
        )
      }
      {
        project.data.sourceUrl && (
          <Button href={project.data.sourceUrl} variant="secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
            </svg>
            <span>Source</span>
          </Button>
        )
      }
      {
        project.data.blogUrl && (
          <Button href={project.data.blogUrl} variant="secondary">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            <span>Blog</span>
          </Button>
        )
      }
    </div>
  </div>
</Layout>
