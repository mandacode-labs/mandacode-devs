---
import Layout from "@/components/layouts/Layout.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getProjectsByLang } from "@/lib/content/projects";
import { useTranslations } from "@/lib/i18n/utils";
import { SUPPORTED_LANGUAGES, isValidLanguage } from "@/lib/config/languages";

export async function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/projects");
}

const t = useTranslations(lang);
const projects = await getProjectsByLang(lang);
---

<Layout title={t("projects.title")} description={t("projects.subtitle")}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <header class="mb-10">
      <h2 class="mb-3">{t("projects.title")}</h2>
      <p class="text-lg text-text-secondary">{t("projects.subtitle")}</p>
    </header>

    <ul class="flex flex-col gap-6">
      {
        projects.map((project) => (
          <li>
            <ProjectCard project={project} lang={lang} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
