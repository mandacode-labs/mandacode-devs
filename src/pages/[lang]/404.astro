---
import Layout from "@/components/layouts/Layout.astro";
import ArrowRight from "@/components/icons/ArrowRight.astro";
import { useTranslations } from "@/lib/i18n/utils";
import { isValidLanguage } from "@/lib/config/languages";

const { lang } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko");
}

const t = useTranslations(lang);
---

<Layout title={t("notFound")}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32">
    <div class="text-center">
      <h2 class="text-8xl sm:text-9xl font-bold mb-4">404</h2>
      <p class="text-xl text-text-secondary mb-8">{t("notFound")}</p>
      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-accent-subtle text-accent font-medium rounded-lg hover:bg-accent hover:text-white transition-colors"
      >
        <span>{t("goHome")}</span>
        <ArrowRight size={18} />
      </a>
    </div>
  </div>
</Layout>
