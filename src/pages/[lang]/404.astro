---
import Layout from "@/components/layouts/Layout.astro";
import { useTranslations, type Lang } from "@/i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "ko" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
---

<Layout title={t("notFound")}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32">
    <div class="text-center">
      <h1 class="text-8xl sm:text-9xl font-bold text-text-primary mb-4">404</h1>
      <p class="text-xl text-text-secondary mb-8">{t("notFound")}</p>
      <a
        href={`/${lang}/`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-accent text-white font-medium rounded-lg hover:bg-accent-hover transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
        >
        <span>{t("goHome")}</span>
      </a>
    </div>
  </div>
</Layout>
