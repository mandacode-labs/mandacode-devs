---
import Layout from "@/components/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import CoverImage from "@/components/ui/CoverImage.astro";
import BackLink from "@/components/ui/BackLink.astro";
import { getCollection, render } from "astro:content";
import { useTranslations } from "@/lib/i18n/utils";
import { formatDate } from "@/lib/utils/date";
import { isValidLanguage } from "@/lib/config/languages";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  for (const post of posts) {
    if (post.data.draft) continue;
    const slug = post.id.split("/").pop();
    paths.push({ params: { lang: post.data.lang, slug } });
  }
  return paths;
}

const { lang, slug } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/blog");
}

const t = useTranslations(lang);

const posts = await getCollection(
  "blog",
  (p) => !p.data.draft && p.data.lang === lang && p.id.endsWith(`/${slug}`),
);
const post = posts[0];

if (!post) {
  return Astro.redirect(`/${lang}/blog`);
}

const title = post.data.title;
const description = post.data.description;
const image = post.data.coverImage || post.data.ogImage;

const { Content } = await render(post);
---

<Layout title={title} description={description} ogImage={image}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <BackLink href={`/${lang}/blog`} label={t("blog.title")} />

    {
      image && (
        <CoverImage
          src={image}
          alt={title}
          class="flex w-full max-h-[30rem] rounded-xl mb-8"
          fetchpriority="high"
        />
      )
    }

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <time class="text-sm text-text-muted"
          >{formatDate(post.data.pubDate, lang)}</time
        >
        <span class="text-text-muted">·</span>
        <div class="flex items-center gap-1.5">
          {post.data.tags.map((tag) => <Badge variant="default">{tag}</Badge>)}
        </div>
      </div>

      <h2>{title}</h2>
      {title}
    </header>

    <p class="text-lg text-text-secondary">{description}</p>
  </div>

  <div class="prose prose-neutral max-w-none">
    <Content />
  </div>
</Layout>
