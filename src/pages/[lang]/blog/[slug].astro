---
import Layout from "@/components/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";
import { getImageUrl } from "@/lib/images";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  for (const post of posts) {
    const slug = post.id.split("/").pop();
    paths.push({ params: { lang: post.data.lang, slug } });
  }
  return paths;
}

const { lang, slug } = Astro.params;
const t = useTranslations(lang as Lang);

const posts = await getCollection(
  "blog",
  (p) => p.data.lang === lang && p.id.endsWith(`/${slug}`),
);
const post = posts[0];

if (!post) {
  return Astro.redirect(`/${lang}/blog`);
}

const title = post.data.title;
const description = post.data.description;
const image = post.data.coverImage 
  ? getImageUrl(post.data.coverImage) 
  : post.data.ogImage 
    ? getImageUrl(post.data.ogImage) 
    : null;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat(lang === "ko" ? "ko-KR" : "en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};

const { Content } = await render(post);
---

<Layout title={title} description={description} ogImage={image}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <a
      href={`/${lang}/blog`}
      class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="rotate-180"
        ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
      >
      <span>{t("blog.title")}</span>
    </a>

    {
      image && (
        <div class="aspect-video rounded-xl overflow-hidden bg-bg-secondary mb-8">
          <img src={image} alt={title} class="w-full h-full object-cover" />
        </div>
      )
    }

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <time class="text-sm text-text-muted"
          >{formatDate(post.data.pubDate)}</time
        >
        <span class="text-text-muted">·</span>
        <div class="flex items-center gap-1.5">
          {post.data.tags.map((tag) => <Badge variant="default">{tag}</Badge>)}
        </div>
      </div>

      <h2 class="mb-4">
        {title}
      </h2>

      <p class="text-lg text-text-secondary">{description}</p>
    </header>

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </div>
</Layout>
