---
import Layout from "@/components/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, type Lang } from "@/lib/i18n/utils";
import { formatDate } from "@/lib/utils/date";
import { isValidLanguage } from "@/lib/config/languages";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  for (const post of posts) {
    const slug = post.id.split("/").pop();
    paths.push({ params: { lang: post.data.lang, slug } });
  }
  return paths;
}

const { lang, slug } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/blog");
}

const typedLang: Lang = lang;
const t = useTranslations(typedLang);

const posts = await getCollection(
  "blog",
  (p) => p.data.lang === typedLang && p.id.endsWith(`/${slug}`),
);
const post = posts[0];

if (!post) {
  return Astro.redirect(`/${typedLang}/blog`);
}

const title = post.data.title;
const description = post.data.description;
const image = post.data.coverImage || post.data.ogImage;

const { Content } = await render(post);
---

<Layout title={title} description={description} ogImage={image}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <a
      href={`/${typedLang}/blog`}
      class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors mb-8"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="rotate-180"
        ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
      >
      <span>{t("blog.title")}</span>
    </a>

    {
      image && (
        <div class="relative flex w-full max-h-[30rem]! justify-center rounded-xl overflow-hidden bg-bg-secondary mb-8">
          <div class="shimmer absolute inset-0 z-10" />
          <img
            src={image}
            alt={title}
            class="relative w-full h-full object-contain opacity-0 transition-opacity duration-300"
            style="z-index: 11;"
            fetchpriority="high"
            decoding="async"
            onload="this.style.opacity='1'; this.previousElementSibling.style.display='none'"
          />
        </div>
      )
    }

    <header class="mb-8">
      <div class="flex items-center gap-2 mb-4">
        <time class="text-sm text-text-muted"
          >{formatDate(post.data.pubDate, typedLang)}</time
        >
        <span class="text-text-muted">·</span>
        <div class="flex items-center gap-1.5">
          {post.data.tags.map((tag) => <Badge variant="default">{tag}</Badge>)}
        </div>
      </div>

      <h2 class="mb-4">
        {title}
      </h2>

      <p class="text-lg text-text-secondary">{description}</p>
    </header>

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </div>
</Layout>
