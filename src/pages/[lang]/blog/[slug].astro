---
import Layout from "@/components/layouts/Layout.astro";
import CoverImage from "@/components/ui/CoverImage.astro";
import BackLink from "@/components/shared/BackLink.astro";
import BlogHeader from "@/components/blog/BlogHeader.astro";
import TiptapRenderer from "@/components/shared/TiptapRenderer.astro";
import { getPost } from "@/lib/content/service";
import { useTranslations } from "@/lib/i18n/utils";
import { isValidLanguage } from "@/lib/config/languages";

const { lang, slug } = Astro.params;

if (!lang || !isValidLanguage(lang) || !slug) {
  return Astro.redirect("/ko/blog");
}

const t = useTranslations(lang);
const post = await getPost(slug, lang);

if (!post) {
  return Astro.redirect(`/${lang}/blog`);
}

const title = post.title;
const description = post.description ?? "";
const image = post.coverImage || post.ogImage;
---

<Layout title={title} description={description} ogImage={image ?? undefined}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <BackLink href={`/${lang}/blog`} label={t("blog.title")} />

    {
      image && (
        <CoverImage
          src={image}
          alt={title}
          class="flex w-full max-h-[30rem] rounded-xl mb-8"
          fetchpriority="high"
        />
      )
    }

    <BlogHeader post={post} lang={lang} />

    <div class="prose prose-neutral max-w-none mt-12">
      {
        post.source === "d1" && post.content ? (
          <TiptapRenderer content={post.content} />
        ) : (
          <div set:html={post.content} />
        )
      }
    </div>
  </div>
</Layout>
