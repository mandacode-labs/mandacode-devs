---
import Layout from "@/components/layouts/Layout.astro";
import CoverImage from "@/components/ui/CoverImage.astro";
import BackLink from "@/components/shared/BackLink.astro";
import BlogHeader from "@/components/blog/BlogHeader.astro";
import { getCollection, render } from "astro:content";
import { getPostBySlug } from "@/lib/content/blog";
import { useTranslations } from "@/lib/i18n/utils";
import { isValidLanguage } from "@/lib/config/languages";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const paths = [];
  for (const post of posts) {
    if (post.data.draft) continue;
    const [lang, slug] = post.id.split("/");
    paths.push({ params: { lang, slug } });
  }
  return paths;
}

const { lang, slug } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/blog");
}

const t = useTranslations(lang);
const post = await getPostBySlug(lang, slug!);

if (!post || post.data.draft) {
  return Astro.redirect(`/${lang}/blog`);
}

const title = post.data.title;
const description = post.data.description;
const image = post.data.coverImage || post.data.ogImage;

const { Content } = await render(post);
---

<Layout title={title} description={description} ogImage={image}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <BackLink href={`/${lang}/blog`} label={t("blog.title")} />

    {
      image && (
        <CoverImage
          src={image}
          alt={title}
          class="flex w-full max-h-[30rem] rounded-xl mb-8"
          fetchpriority="high"
        />
      )
    }

    <BlogHeader post={post} lang={lang} />

    <div class="prose prose-neutral max-w-none mt-12">
      <Content />
    </div>
  </div>
</Layout>
