---
import BlogPostDetail from "@/components/blog/BlogPostDetail.astro";
import BlogFolder from "@/components/blog/BlogFolder.astro";
import { getPost, getPosts, getPostPaths } from "@/lib/content/service";
import { useTranslations } from "@/lib/i18n/utils";
import { isValidLanguage, getLocaleFromRequest } from "@/lib/config/languages";
import type { Lang } from "@/types";

const { lang, path } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  const locale = getLocaleFromRequest(Astro.request, Astro.url.pathname);
  return Astro.redirect(`/${locale}/blog`);
}

const typedLang = lang as Lang;
const t = useTranslations(typedLang);

const rawSegments = path ?? "";
const segments = rawSegments.split("/").filter(Boolean);

const folderPath =
  segments.length === 0
    ? "/"
    : "/" + segments.join("/") + (rawSegments.endsWith("/") ? "/" : "/");

let post: Awaited<ReturnType<typeof getPost>> = null;
if (segments.length > 0 && !rawSegments.endsWith("/")) {
  post = await getPost(segments[segments.length - 1]!, typedLang);
}

const posts = post ? [] : await getPosts(typedLang, { pathPrefix: folderPath });
const paths = await getPostPaths();
const folderLabel = folderPath === "/" ? t("blog.allPosts") : folderPath;
---

{
  post ? (
    <BlogPostDetail post={post} lang={typedLang} backPath={folderPath} />
  ) : (
    <BlogFolder
      lang={typedLang}
      folderPath={folderPath}
      folderLabel={folderLabel}
      posts={posts}
      paths={paths}
    />
  )
}
