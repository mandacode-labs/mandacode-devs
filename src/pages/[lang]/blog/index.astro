---
import Layout from "@/components/layouts/Layout.astro";
import BlogCard from "@/components/blog/BlogCard.astro";
import EmptyBlog from "@/components/blog/EmptyBlog.astro";
import { getPublishedPostsByLang } from "@/lib/content/blog";
import { useTranslations } from "@/lib/i18n/utils";
import { SUPPORTED_LANGUAGES, isValidLanguage } from "@/lib/config/languages";

export async function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/blog");
}

const t = useTranslations(lang);
const posts = await getPublishedPostsByLang(lang);
---

<Layout title={t("blog.title")} description={t("blog.subtitle")}>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <header class="mb-10">
      <h2 class="mb-3">{t("blog.title")}</h2>
      <p class="text-lg text-text-secondary">{t("blog.subtitle")}</p>
    </header>

    {
      posts.length > 0 ? (
        <ul class="flex flex-col gap-6">
          {posts.map((post) => (
            <li>
              <BlogCard post={post} lang={lang} />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyBlog lang={lang} />
      )
    }
  </section>
</Layout>
