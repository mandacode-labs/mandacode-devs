---
import Layout from "@/components/layouts/Layout.astro";
import SocialLink from "@/components/ui/SocialLink.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, type Lang } from "@/lib/i18n/utils";
import { SUPPORTED_LANGUAGES, isValidLanguage } from "@/lib/config/languages";

export async function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/developer");
}

const typedLang: Lang = lang;
const t = useTranslations(typedLang);

const developers = await getCollection(
  "developers",
  (dev) => dev.data.lang === typedLang,
);
const developer = developers[0];

if (!developer) {
  return Astro.redirect(`/${typedLang}`);
}

const name = developer.data.name;
const role = developer.data.role;
const bio = developer.data.bio;
const avatar = developer.data.avatar || "https://github.com/github.png";

const { Content } = await render(developer);
---

<Layout title={name} description={bio}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row items-start gap-6 mb-6">
      <div class="flex-shrink-0">
        <img
          src={avatar}
          alt={name}
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border-2 border-border"
        />
      </div>

      <div class="flex-1 flex flex-col items-start gap-3">
        <div>
          <h2 class="text-2xl sm:text-4xl">
            {name}
          </h2>
          <p class="text-base sm:text-lg text-accent font-medium mt-1">
            {role}
          </p>
          <p class="text-sm sm:text-base text-text-secondary mt-1">{bio}</p>
        </div>

        <div class="flex items-center gap-3 w-full">
          <div class="flex items-center gap-3">
            {
              developer.data.github && (
                <SocialLink
                  platform="github"
                  href={developer.data.github}
                  size="sm"
                />
              )
            }
            {
              developer.data.email && (
                <SocialLink
                  platform="email"
                  href={developer.data.email}
                  size="sm"
                />
              )
            }
            {
              developer.data.website && (
                <SocialLink
                  platform="website"
                  href={developer.data.website}
                  size="sm"
                />
              )
            }
          </div>

          <div class="no-print ml-auto">
            <Button
              variant="secondary"
              class="px-3 py-1.5 text-xs"
              onclick="window.print()"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><polyline points="6 9 6 2 18 2 18 9"></polyline><path
                  d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"
                ></path><rect x="6" y="14" width="12" height="8"></rect></svg
              >
              <span>{t("print")}</span>
            </Button>
          </div>
        </div>
      </div>
    </div>

    {
      developer.data.techStack && developer.data.techStack.length > 0 && (
        <section class="mb-10">
          <h3 class="mb-4">{t("techStack")}</h3>
          <ul class="flex flex-wrap gap-2">
            {developer.data.techStack.map((tech) => (
              <li class="px-3 py-1.5 bg-surface border border-border rounded-lg text-sm text-text-secondary">
                {tech}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      developer.data.certifications &&
        developer.data.certifications.length > 0 && (
          <section class="mb-10">
            <h3 class="mb-4">{t("certifications")}</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {developer.data.certifications.map((cert) => (
                <li class="flex items-center gap-4 p-4 bg-surface border border-border rounded-xl">
                  {cert.badge && (
                    <img
                      src={cert.badge}
                      alt={cert.name}
                      class="w-16 h-16 object-contain flex-shrink-0"
                      loading="lazy"
                    />
                  )}
                  <div class="flex-1 min-w-0">
                    <h6 class="mb-1">
                      {cert.url ? (
                        <a
                          href={cert.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:text-accent transition-colors"
                        >
                          {cert.name}
                        </a>
                      ) : (
                        cert.name
                      )}
                    </h6>
                    <p class="text-xs text-text-muted mb-1">{cert.issuer}</p>
                    <p class="text-xs text-text-secondary">{cert.date}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
    }

    {
      developer.data.education && developer.data.education.length > 0 && (
        <section class="mb-10">
          <h3 class="mb-4">{t("education")}</h3>
          <ul class="space-y-4">
            {developer.data.education.map((edu) => (
              <li class="flex flex-col sm:flex-row sm:items-center gap-2 p-4 bg-surface border border-border rounded-xl">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h5>{edu.institution}</h5>
                    <span class="px-2 py-0.5 text-xs bg-accent/10 text-accent rounded-full">
                      {edu.status}
                    </span>
                  </div>
                  <p class="text-sm text-text-secondary">{edu.department}</p>
                </div>
                <p class="text-sm text-text-muted whitespace-nowrap">
                  {edu.period}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </div>
</Layout>
