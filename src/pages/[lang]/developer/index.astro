---
import Layout from "@/components/layouts/Layout.astro";
import DeveloperProfile from "@/components/developer/DeveloperProfile.astro";
import TechStack from "@/components/developer/TechStack.astro";
import Certifications from "@/components/developer/Certifications.astro";
import Education from "@/components/developer/Education.astro";
import ProjectTimeline from "@/components/developer/ProjectTimeline.astro";
import ContentRenderer from "@/components/shared/ContentRenderer.astro";
import { getCollection } from "astro:content";
import { getDeveloper } from "@/lib/content/service";
import { sortProjectsByDate } from "@/lib/content/projects";
import { isValidLanguage, MAIN_DEVELOPER_ID } from "@/lib/config/languages";

const { lang } = Astro.params;

if (!lang || !isValidLanguage(lang)) {
  return Astro.redirect("/ko/developer");
}

const developer = await getDeveloper(MAIN_DEVELOPER_ID, lang);

if (!developer) {
  return Astro.redirect(`/${lang}`);
}

const name = developer.name;
const bio = developer.bio;

const projects = sortProjectsByDate(
  await getCollection("projects", (project) =>
    project.id.startsWith(`${lang}/`),
  ),
);
---

<Layout title={name} description={bio}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <DeveloperProfile developer={developer} lang={lang} />

    <ContentRenderer
      d1Content={developer.d1Content}
      markdownContent={developer.markdownContent}
      mode="fallback"
      class="mb-10"
    />

    <TechStack developer={developer} lang={lang} />

    <Certifications developer={developer} lang={lang} />

    <Education developer={developer} lang={lang} />

    <ProjectTimeline projects={projects} lang={lang} />
  </div>
</Layout>
