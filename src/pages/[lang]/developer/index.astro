---
import Layout from "@/components/layouts/Layout.astro";
import DeveloperCard from "@/components/content/DeveloperCard.astro";
import { getCollection } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";

export async function getStaticPaths() {
  return [{ params: { lang: "ko" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);

const developers = await getCollection("developers");
---

<Layout title={t("developer.title")} description={t("developer.subtitle")}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-3">
        {t("developer.title")}
      </h1>
      <p class="text-lg text-text-secondary">{t("developer.subtitle")}</p>
    </div>

    <div class="max-w-2xl">
      {
        developers.map((developer) => (
          <DeveloperCard developer={developer} lang={lang as Lang} />
        ))
      }
    </div>
  </div>
</Layout>
