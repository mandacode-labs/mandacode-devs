---
import Layout from "@/components/layouts/Layout.astro";
import SocialLink from "@/components/ui/SocialLink.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";

export async function getStaticPaths() {
  return [{ params: { lang: "ko" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);

const developers = await getCollection(
  "developers",
  (dev) => dev.data.lang === lang,
);
const developer = developers[0];

if (!developer) {
  return Astro.redirect(`/${lang}`);
}

const name = developer.data.name;
const role = developer.data.role;
const bio = developer.data.bio;
const avatar = developer.data.avatar || "https://github.com/github.png";

const { Content } = await render(developer);
---

<Layout title={name} description={bio}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <header class="flex flex-row items-start gap-4 sm:gap-6 mb-6">
      <div class="flex-shrink-0">
        <img
          src={avatar}
          alt={name}
          class="w-28 h-28 sm:w-32 sm:h-32 rounded-2xl object-cover border-2 border-border"
        />
      </div>

      <div class="flex flex-col items-start gap-2 sm:gap-4">
        <h2 class="text-2xl sm:text-4xl">
          {name}
        </h2>
        <div class="flex flex-col items-start gap-2 ml-1">
          <p class="text-base sm:text-lg text-accent font-medium">
            {role}
          </p>
          <p class="text-sm sm:text-base text-text-secondary">{bio}</p>
        </div>
      </div>
    </header>

    <div class="flex items-center gap-3 mb-10">
      {
        developer.data.github && (
          <SocialLink
            platform="github"
            href={developer.data.github}
            size="sm"
          />
        )
      }
      {
        developer.data.email && (
          <SocialLink platform="email" href={developer.data.email} size="sm" />
        )
      }
      {
        developer.data.website && (
          <SocialLink
            platform="website"
            href={developer.data.website}
            size="sm"
          />
        )
      }
    </div>

    {
      developer.data.techStack && developer.data.techStack.length > 0 && (
        <section class="mb-10">
          <h3 class="mb-4">{t("techStack")}</h3>
          <ul class="flex flex-wrap gap-2">
            {developer.data.techStack.map((tech) => (
              <li class="px-3 py-1.5 bg-surface border border-border rounded-lg text-sm text-text-secondary">
                {tech}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      developer.data.certifications &&
        developer.data.certifications.length > 0 && (
          <section class="mb-10">
            <h3 class="mb-4">{t("certifications")}</h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {developer.data.certifications.map((cert) => (
                <li class="flex items-start gap-4 p-4 bg-surface border border-border rounded-xl">
                  {cert.badge && (
                    <img
                      src={cert.badge}
                      alt={cert.name}
                      class="w-16 h-16 object-contain flex-shrink-0"
                      loading="lazy"
                    />
                  )}
                  <div class="flex-1 min-w-0">
                    <h6 class="mb-1">
                      {cert.url ? (
                        <a
                          href={cert.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="hover:text-accent transition-colors"
                        >
                          {cert.name}
                        </a>
                      ) : (
                        cert.name
                      )}
                    </h6>
                    <p class="text-xs text-text-muted mb-1">{cert.issuer}</p>
                    <p class="text-xs text-text-secondary">{cert.date}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
    }

    {
      developer.data.education && developer.data.education.length > 0 && (
        <section class="mb-10">
          <h3 class="mb-4">{t("education")}</h3>
          <ul class="space-y-4">
            {developer.data.education.map((edu) => (
              <li class="flex flex-col sm:flex-row sm:items-center gap-2 p-4 bg-surface border border-border rounded-xl">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h5>{edu.institution}</h5>
                    <span class="px-2 py-0.5 text-xs bg-accent/10 text-accent rounded-full">
                      {edu.status}
                    </span>
                  </div>
                  <p class="text-sm text-text-secondary">{edu.department}</p>
                </div>
                <p class="text-sm text-text-muted whitespace-nowrap">
                  {edu.period}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </div>
</Layout>
