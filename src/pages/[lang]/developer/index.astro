---
import Layout from "@/components/layouts/Layout.astro";
import Button from "@/components/ui/Button.astro";
import { getCollection, render } from "astro:content";
import { useTranslations, type Lang } from "@/i18n/utils";

export async function getStaticPaths() {
  return [{ params: { lang: "ko" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);

const developers = await getCollection(
  "developers",
  (dev) => dev.data.lang === lang,
);
const developer = developers[0];

if (!developer) {
  return Astro.redirect(`/${lang}`);
}

const name = developer.data.name;
const role = developer.data.role;
const bio = developer.data.bio;
const avatar = developer.data.avatar || "https://github.com/github.png";

const { Content } = await render(developer);
---

<Layout title={name} description={bio}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row items-start gap-8 mb-10">
      <div class="flex-shrink-0">
        <img
          src={avatar}
          alt={name}
          class="w-32 h-32 rounded-2xl object-cover border-2 border-border"
        />
      </div>

      <div class="flex-1">
        <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-2">
          {name}
        </h1>
        <p class="text-lg text-accent font-medium mb-4">{role}</p>
        <p class="text-text-secondary mb-6">{bio}</p>

        <div class="flex items-center gap-3">
          {
            developer.data.github && (
              <Button href={developer.data.github} variant="secondary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                >
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                <span>GitHub</span>
              </Button>
            )
          }
          {
            developer.data.email && (
              <Button
                href={`mailto:${developer.data.email}`}
                variant="secondary"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <rect width="20" height="16" x="2" y="4" rx="2" />
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                  </>
                </svg>
                <span>Email</span>
              </Button>
            )
          }
          {
            developer.data.website && (
              <Button href={developer.data.website} variant="secondary">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <>
                    <circle cx="12" cy="12" r="10" />
                    <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
                    <path d="M2 12h20" />
                  </>
                </svg>
                <span>Website</span>
              </Button>
            )
          }
        </div>
      </div>
    </div>

    {
      developer.data.techStack && developer.data.techStack.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4">
            {t("techStack")}
          </h2>
          <div class="flex flex-wrap gap-2">
            {developer.data.techStack.map((tech) => (
              <span class="px-3 py-1.5 bg-surface border border-border rounded-lg text-sm text-text-secondary">
                {tech}
              </span>
            ))}
          </div>
        </div>
      )
    }

    {
      developer.data.certifications && developer.data.certifications.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4">
            {t("certifications")}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {developer.data.certifications.map((cert) => (
              <div class="flex items-start gap-4 p-4 bg-surface border border-border rounded-xl">
                {cert.badge && (
                  <img
                    src={cert.badge}
                    alt={cert.name}
                    class="w-16 h-16 object-contain flex-shrink-0"
                    loading="lazy"
                  />
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium text-text-primary text-sm mb-1">
                    {cert.url ? (
                      <a
                        href={cert.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-accent transition-colors"
                      >
                        {cert.name}
                      </a>
                    ) : (
                      cert.name
                    )}
                  </h3>
                  <p class="text-xs text-text-muted mb-1">{cert.issuer}</p>
                  <p class="text-xs text-text-secondary">{cert.date}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      developer.data.education && developer.data.education.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-semibold text-text-primary mb-4">
            {t("education")}
          </h2>
          <div class="space-y-4">
            {developer.data.education.map((edu) => (
              <div class="flex flex-col sm:flex-row sm:items-center gap-2 p-4 bg-surface border border-border rounded-xl">
                <div class="flex-1">
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="font-medium text-text-primary">{edu.institution}</h3>
                    <span class="px-2 py-0.5 text-xs bg-accent/10 text-accent rounded-full">
                      {edu.status}
                    </span>
                  </div>
                  <p class="text-sm text-text-secondary">{edu.department}</p>
                </div>
                <p class="text-sm text-text-muted whitespace-nowrap">{edu.period}</p>
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="prose prose-neutral max-w-none">
      <Content />
    </div>
  </div>
</Layout>
