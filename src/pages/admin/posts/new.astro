---
import AdminFormLayout from "@/components/admin/AdminFormLayout.astro";
import PostEditor from "@/components/admin/PostEditor";
import { requireAuth } from "@/lib/auth";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE } from "@/lib/config/languages";

requireAuth(Astro);
const t = useTranslations(DEFAULT_LANGUAGE);
---

<AdminFormLayout
  title={t("admin.newPost")}
  headerTitle={t("admin.newPost")}
  backHref="/admin/posts"
  backLabel="Back to posts"
  currentPath="/admin/posts"
>
  <PostEditor client:only="react" />
</AdminFormLayout>
