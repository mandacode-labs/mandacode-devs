---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { AdminList } from "@/components/admin/AdminList";
import { requireAuth } from "@/lib/auth";
import { getAllPosts } from "@/lib/db/posts";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";
import type { Post } from "@/lib/db/schema";
import type { AdminListItem } from "@/components/admin/AdminList";

requireAuth(Astro);

const posts = await getAllPosts();
const t = useTranslations(DEFAULT_LANGUAGE);

const grouped = posts.reduce(
  (acc, post) => {
    if (!acc[post.id]) acc[post.id] = [];
    acc[post.id].push(post);
    return acc;
  },
  {} as Record<string, Post[]>,
);

const groupedArray = Object.entries(grouped).map(([id, locales]) => {
  const primary =
    locales.find((p) => p.locale === DEFAULT_LANGUAGE) || locales[0];
  const missingLocales = SUPPORTED_LANGUAGES.filter(
    (lang) => !locales.some((p) => p.locale === lang),
  );
  return { id, locales, primary, missingLocales };
});

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const items: AdminListItem[] = groupedArray.map(
  ({ id, locales, primary, missingLocales }) => ({
    id,
    title: primary.title,
    href: `/admin/posts/edit/${id}?locale=${DEFAULT_LANGUAGE}`,
    meta: `/${id}`,
    status: primary.publish_status,
    locales: [
      ...locales.map((post) => ({
        locale: post.locale,
        href: `/admin/posts/edit/${post.id}?locale=${post.locale}`,
        active: post.publish_status !== "archived",
        title: `Edit ${post.locale}`,
      })),
      ...missingLocales.map((locale) => ({
        locale,
        href: `/admin/posts/edit/${id}?locale=${locale}`,
        active: false,
        title: `Create ${locale}`,
      })),
    ],
    extras: {
      date: formatDate(primary.pub_date),
      updated: formatDate(primary.updated_at),
    },
  }),
);

const translations: Record<string, string> = {};
---

<AdminLayout title={t("admin.posts")}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={Astro.url.pathname} />

    <div class="flex-1 md:ml-64">
      <AdminHeader
        title={t("admin.posts")}
        subtitle="Manage blog posts across languages"
      />

      <main class="p-4 sm:p-6 lg:p-8">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
        >
          <div>
            <h1 class="text-2xl font-bold text-text-primary">
              {t("admin.posts")}
            </h1>
            <p class="text-sm text-text-secondary mt-1">
              {Object.keys(grouped).length} posts · {posts.length} language versions
            </p>
          </div>
          <a
            href="/admin/posts/new"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-4 h-4"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            {t("admin.newPost")}
          </a>
        </div>

        <AdminList
          items={items}
          contentType="post"
          entityType="posts"
          columns={[
            { key: "status", label: t("admin.status") },
            { key: "date", label: t("admin.publishDate") },
            { key: "updated", label: t("admin.updated") },
          ]}
          emptyTitle={t("admin.noItems")}
          emptyMessage="Create your first post to get started."
          deleteModalTitle={t("admin.deletePost")}
          translations={translations}
          client:only="react"
        />
      </main>
    </div>
  </div>
</AdminLayout>
