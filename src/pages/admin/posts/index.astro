---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { AdminList } from "@/components/admin/AdminList";
import { requireAuth } from "@/lib/auth";
import {
  getPosts,
  getPostLocales,
  getPostLocaleMeta,
  getPostOriginalHash,
} from "@/lib/db/posts";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";
import type { AdminListItem } from "@/components/admin/AdminList";

requireAuth(Astro);

const posts = await getPosts(DEFAULT_LANGUAGE, { includeUnpublished: true });
const t = useTranslations(DEFAULT_LANGUAGE);

function formatDate(iso: string | null): string {
  if (!iso) return "-";
  return new Date(iso).toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

const itemsWithLocales = await Promise.all(
  posts.map(async (post) => {
    const [existingLocales, localeMeta, originalHash] = await Promise.all([
      getPostLocales(post.id),
      getPostLocaleMeta(post.id),
      getPostOriginalHash(post.id),
    ]);
    const missingLocales = SUPPORTED_LANGUAGES.filter(
      (lang) => !existingLocales.includes(lang),
    );
    return { post, existingLocales, missingLocales, localeMeta, originalHash };
  }),
);

const items: AdminListItem[] = itemsWithLocales.map(
  ({ post, existingLocales, missingLocales, localeMeta, originalHash }) => ({
    id: post.id,
    title: post.title,
    href: `/admin/posts/edit/${post.id}?locale=${DEFAULT_LANGUAGE}`,
    viewHref: `/admin/posts/view/${post.id}?locale=${DEFAULT_LANGUAGE}`,
    meta: `/${post.id}`,
    originalLocale: post.original_locale,
    existingLocales,
    locales: [
      ...existingLocales.map((locale) => {
        const meta = localeMeta.find((m) => m.locale === locale);
        const isOutdated =
          originalHash !== null &&
          meta !== undefined &&
          meta.source_hash !== null &&
          meta.source_hash !== originalHash;
        return {
          locale,
          href: `/admin/posts/edit/${post.id}?locale=${locale}`,
          active: true,
          title: `Edit ${locale}`,
          publishStatus: meta?.publish_status ?? null,
          isOutdated,
        };
      }),
      ...missingLocales.map((locale) => ({
        locale,
        href: `/admin/posts/edit/${post.id}?locale=${locale}`,
        active: false,
        title: `Create ${locale}`,
        publishStatus: null,
        isOutdated: false,
      })),
    ],
    extras: {
      date: formatDate(post.published_at),
      updated: formatDate(post.updated_at),
    },
  }),
);

const totalLocales = itemsWithLocales.reduce(
  (sum, { existingLocales }) => sum + existingLocales.length,
  0,
);

const translations: Record<string, string> = {};
---

<AdminLayout title={t("admin.posts")}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={Astro.url.pathname} />

    <div class="flex-1 md:ml-64">
      <AdminHeader
        title={t("admin.posts")}
        subtitle="Manage blog posts across languages"
      />

      <main class="p-4 sm:p-6 lg:p-8">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
        >
          <div>
            <h1 class="text-2xl font-bold text-text-primary">
              {t("admin.posts")}
            </h1>
            <p class="text-sm text-text-secondary mt-1">
              {posts.length} posts · {totalLocales} language versions
            </p>
          </div>
          <a
            href="/admin/posts/new"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-4 h-4"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            {t("admin.newPost")}
          </a>
        </div>

        <AdminList
          items={items}
          contentType="post"
          entityType="posts"
          columns={[
            { key: "date", label: t("admin.publishDate") },
            { key: "updated", label: t("admin.updated") },
          ]}
          emptyTitle={t("admin.noItems")}
          emptyMessage="Create your first post to get started."
          deleteModalTitle={t("admin.deletePost")}
          translations={translations}
          client:only="react"
        />
      </main>
    </div>
  </div>
</AdminLayout>
