---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import AdminCard from "@/components/admin/AdminCard.astro";
import StatusBadge from "@/components/admin/StatusBadge.astro";
import EmptyState from "@/components/admin/EmptyState.astro";
import { AdminLocaleChips } from "@/components/admin/AdminLocaleChips";
import { requireAuth } from "@/lib/auth";
import { getAllPosts } from "@/lib/db/posts";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";
import type { Post } from "@/lib/db/schema";

requireAuth(Astro);

const posts = await getAllPosts();
const t = useTranslations(DEFAULT_LANGUAGE);

const grouped = posts.reduce(
  (acc, post) => {
    if (!acc[post.id]) acc[post.id] = [];
    acc[post.id].push(post);
    return acc;
  },
  {} as Record<string, Post[]>,
);

const groupedArray = Object.entries(grouped).map(([id, locales]) => {
  const primary =
    locales.find((p) => p.locale === DEFAULT_LANGUAGE) || locales[0];
  const missingLocales = SUPPORTED_LANGUAGES.filter(
    (lang) => !locales.some((p) => p.locale === lang),
  );
  return { id, locales, primary, missingLocales };
});

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<AdminLayout title={t("admin.posts")}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={Astro.url.pathname} />

    <div class="flex-1 md:ml-64">
      <AdminHeader
        title={t("admin.posts")}
        subtitle="Manage blog posts across languages"
      />

      <main class="p-4 sm:p-6 lg:p-8">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
        >
          <div>
            <h1 class="text-2xl font-bold text-text-primary">
              {t("admin.posts")}
            </h1>
            <p class="text-sm text-text-secondary mt-1">
              {Object.keys(grouped).length} posts · {posts.length} language versions
            </p>
          </div>
          <a
            href="/admin/posts/new"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-4 h-4"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            {t("admin.newPost")}
          </a>
        </div>

        {
          groupedArray.length === 0 ? (
            <AdminCard>
              <EmptyState
                title="No posts yet"
                message="Create your first post to get started."
              />
            </AdminCard>
          ) : (
            <AdminCard class="overflow-hidden">
              <div class="overflow-x-auto">
                <table class="w-full text-sm">
                  <thead class="bg-bg-secondary border-b border-border">
                    <tr>
                      <th class="px-5 py-3.5 text-left font-semibold text-text-secondary text-xs uppercase tracking-wide">
                        Post
                      </th>
                      <th class="px-5 py-3.5 text-left font-semibold text-text-secondary text-xs uppercase tracking-wide">
                        Locales
                      </th>
                      <th class="px-5 py-3.5 text-left font-semibold text-text-secondary text-xs uppercase tracking-wide">
                        Primary Status
                      </th>
                      <th class="px-5 py-3.5 text-left font-semibold text-text-secondary text-xs uppercase tracking-wide">
                        Publish Date
                      </th>
                      <th class="px-5 py-3.5 text-left font-semibold text-text-secondary text-xs uppercase tracking-wide">
                        Updated
                      </th>
                      <th class="px-5 py-3.5 text-right font-semibold text-text-secondary text-xs uppercase tracking-wide">
                        Actions
                      </th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-border">
                    {groupedArray.map(
                      ({ id, locales, primary, missingLocales }) => (
                        <tr class="hover:bg-bg-secondary/50 transition-colors group">
                          <td class="px-5 py-4">
                            <div class="flex items-start gap-3">
                              <div class="w-9 h-9 rounded-lg bg-bg-tertiary flex items-center justify-center shrink-0">
                                <svg
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.5"
                                  class="w-4.5 h-4.5 text-text-muted"
                                >
                                  <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                  <polyline points="14 2 14 8 20 8" />
                                </svg>
                              </div>
                              <div>
                                <p class="font-medium text-text-primary">
                                  {primary.title}
                                </p>
                                <p class="text-xs text-text-muted font-mono mt-0.5">
                                  /{id}
                                </p>
                              </div>
                            </div>
                          </td>
                          <td class="px-5 py-4">
                            <AdminLocaleChips
                              contentType="post"
                              contentId={id}
                              locales={[
                                ...locales.map((post) => ({
                                  locale: post.locale,
                                  href: `/admin/posts/edit/${post.id}?locale=${post.locale}`,
                                  active: post.publish_status !== "archived",
                                  title: `Edit ${post.locale}`,
                                })),
                                ...missingLocales.map((locale) => ({
                                  locale,
                                  href: `/admin/posts/edit/${id}?locale=${locale}`,
                                  active: false,
                                  title: `Create ${locale}`,
                                })),
                              ]}
                              client:only="react"
                            />
                          </td>
                          <td class="px-5 py-4">
                            <StatusBadge status={primary.publish_status} />
                            {primary.publish_status === "archived" && (
                              <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium border bg-neutral-100 text-neutral-600 border-neutral-200">
                                Archived
                              </span>
                            )}
                          </td>
                          <td class="px-5 py-4 text-text-secondary">
                            {formatDate(primary.pub_date)}
                          </td>
                          <td class="px-5 py-4 text-text-secondary">
                            {formatDate(primary.updated_at)}
                          </td>
                          <td class="px-5 py-4 text-right">
                            <div class="flex items-center justify-end gap-2 opacity-80 group-hover:opacity-100 transition-opacity">
                              <a
                                href={`/admin/posts/edit/${id}?locale=${DEFAULT_LANGUAGE}`}
                                class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-text-primary bg-bg-secondary hover:bg-bg-tertiary border border-border rounded-md transition-colors"
                              >
                                Edit
                              </a>
                              <a
                                href={`/admin/posts/edit/${id}?locale=${DEFAULT_LANGUAGE}`}
                                class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-accent hover:text-accent-hover hover:bg-accent-subtle rounded-md transition-colors"
                              >
                                View
                              </a>
                            </div>
                          </td>
                        </tr>
                      ),
                    )}
                  </tbody>
                </table>
              </div>
            </AdminCard>
          )
        }
      </main>
    </div>
  </div>
</AdminLayout>
