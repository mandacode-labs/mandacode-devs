---
import AdminPageLayout from "@/components/admin/AdminPageLayout.astro";
import { AdminList } from "@/components/admin/AdminList";
import Icon from "@/components/icons/Icon.astro";
import { requireAuth } from "@/lib/auth";
import {
  getDevelopers,
  getDeveloperLocales,
  getDeveloperLocaleMeta,
  getDeveloperOriginalHash,
} from "@/lib/db/developers";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";
import { formatShortDate } from "@/lib/utils/date";
import { Plus } from "lucide-react";
import type { AdminListItem } from "@/components/admin/AdminList";

requireAuth(Astro);

const developers = await getDevelopers(DEFAULT_LANGUAGE, {
  includeUnpublished: true,
});
const t = useTranslations(DEFAULT_LANGUAGE);

const itemsWithLocales = await Promise.all(
  developers.map(async (developer) => {
    const [existingLocales, localeMeta, originalHash] = await Promise.all([
      getDeveloperLocales(developer.id),
      getDeveloperLocaleMeta(developer.id),
      getDeveloperOriginalHash(developer.id),
    ]);
    const missingLocales = SUPPORTED_LANGUAGES.filter(
      (lang) => !existingLocales.includes(lang),
    );
    return {
      developer,
      existingLocales,
      missingLocales,
      localeMeta,
      originalHash,
    };
  }),
);

const items: AdminListItem[] = itemsWithLocales.map(
  ({
    developer,
    existingLocales,
    missingLocales,
    localeMeta,
    originalHash,
  }) => ({
    id: developer.id,
    title: developer.name,
    href: `/admin/developers/edit/${developer.id}?locale=${DEFAULT_LANGUAGE}`,
    viewHref: `/admin/developers/view/${developer.id}?locale=${DEFAULT_LANGUAGE}`,
    meta: `/${developer.id}`,
    originalLocale: developer.original_locale,
    existingLocales,
    locales: [
      ...existingLocales.map((locale) => {
        const meta = localeMeta.find((m) => m.locale === locale);
        const isOutdated =
          originalHash !== null &&
          meta !== undefined &&
          meta.source_hash !== null &&
          meta.source_hash !== originalHash;
        return {
          locale,
          href: `/admin/developers/edit/${developer.id}?locale=${locale}`,
          active: true,
          title: `Edit ${locale}`,
          publishStatus: meta?.publish_status ?? null,
          isOutdated,
        };
      }),
      ...missingLocales.map((locale) => ({
        locale,
        href: `/admin/developers/edit/${developer.id}?locale=${locale}`,
        active: false,
        title: `Create ${locale}`,
        publishStatus: null,
        isOutdated: false,
      })),
    ],
    extras: {
      role: developer.role,
      updated: formatShortDate(developer.updated_at),
    },
  }),
);

const totalLocales = itemsWithLocales.reduce(
  (sum, { existingLocales }) => sum + existingLocales.length,
  0,
);

const translations: Record<string, string> = {};
---

<AdminPageLayout
  title={t("admin.developer")}
  headerTitle={t("admin.developer")}
  headerSubtitle="Manage developer profile translations"
  currentPath={Astro.url.pathname}
>
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
  >
    <div>
      <h1 class="text-2xl font-bold text-text-primary">
        {t("admin.developer")}
      </h1>
      <p class="text-sm text-text-secondary mt-1">
        {developers.length} profiles · {totalLocales} language versions
      </p>
    </div>
    <a
      href="/admin/developers/new"
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
    >
      <Icon icon={Plus} class="w-4 h-4" />
      {t("admin.newProfile")}
    </a>
  </div>

  <AdminList
    items={items}
    contentType="developer"
    entityType="developers"
    statusLabel={t("admin.statusColumn")}
    columns={[
      { key: "role", label: t("admin.role") },
      { key: "updated", label: t("admin.updated") },
    ]}
    emptyTitle={t("admin.noItems")}
    emptyMessage="Create a developer profile to get started."
    deleteModalTitle={t("admin.deleteProfile")}
    translations={translations}
    client:only="react"
  />
</AdminPageLayout>
