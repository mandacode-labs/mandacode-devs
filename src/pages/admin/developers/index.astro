---
import Layout from "@/components/layouts/Layout.astro";
import { requireAuth } from "@/lib/auth";
import { getAllDevelopers } from "@/lib/db/developers";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, MAIN_DEVELOPER_ID } from "@/lib/config/languages";
import type { Developer } from "@/lib/db/schema";

requireAuth(Astro);

const developers = await getAllDevelopers();
const t = useTranslations(DEFAULT_LANGUAGE);

const grouped = developers.reduce(
  (acc, developer) => {
    if (!acc[developer.id]) acc[developer.id] = [];
    acc[developer.id].push(developer);
    return acc;
  },
  {} as Record<string, Developer[]>,
);
---

<Layout title={t("admin.developer")}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold">{t("admin.developer")}</h1>
      <a
        href={`/admin/developers/edit/${MAIN_DEVELOPER_ID}?locale=${DEFAULT_LANGUAGE}`}
        class="px-4 py-2 bg-accent text-white rounded hover:bg-accent/90"
      >
        {t("admin.edit")}
      </a>
    </div>

    {
      Object.keys(grouped).length === 0 ? (
        <p class="text-text-secondary">{t("admin.noItems")}</p>
      ) : (
        <div class="space-y-4">
          {Object.entries(grouped).map(([id, locales]) => {
            const primary =
              locales.find((d) => d.locale === DEFAULT_LANGUAGE) || locales[0];
            return (
              <div class="border border-border rounded-xl p-4 bg-bg-primary">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h2 class="text-lg font-semibold">{primary.name}</h2>
                    <p class="text-sm text-text-secondary">{id}</p>
                    <div class="flex flex-wrap gap-2 mt-2">
                      {locales.map((developer) => (
                        <a
                          href={`/admin/developers/edit/${developer.id}?locale=${developer.locale}`}
                          class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs border border-border"
                        >
                          <span class="font-medium">{developer.locale}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                  <div class="flex flex-col gap-2">
                    <a
                      href={`/admin/developers/edit/${id}?locale=${DEFAULT_LANGUAGE}`}
                      class="text-sm px-3 py-1.5 border border-border rounded hover:border-border-hover text-center"
                    >
                      {t("admin.edit")}
                    </a>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )
    }
  </div>
</Layout>
