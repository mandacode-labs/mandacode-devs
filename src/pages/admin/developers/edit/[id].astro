---
import AdminFormLayout from "@/components/admin/AdminFormLayout.astro";
import DeveloperEditor from "@/components/admin/DeveloperEditor";
import { requireAuth } from "@/lib/auth";
import {
  getDeveloperById,
  getDeveloperTranslationById,
  getDeveloperLocales,
} from "@/lib/db/developers";
import { useTranslations } from "@/lib/i18n/utils";
import { ui } from "@/lib/i18n";
import { tryParseJson } from "@/lib/utils/json";
import { DEFAULT_LANGUAGE } from "@/lib/config/languages";

requireAuth(Astro);

const { id } = Astro.params;
const locale = Astro.url.searchParams.get("locale") || DEFAULT_LANGUAGE;
const t = useTranslations(DEFAULT_LANGUAGE);

if (!id) {
  return Astro.redirect("/admin/developers");
}

const developer = await getDeveloperById(id, locale);

if (!developer) {
  return Astro.redirect("/admin/developers");
}

const [translation, existingLocales] = await Promise.all([
  getDeveloperTranslationById(id, locale),
  getDeveloperLocales(id),
]);

const data = translation ?? developer;

const initialData = {
  id: developer.id,
  locale,
  original_locale: developer.original_locale,
  existing_locales: existingLocales,
  name: data.name,
  role: data.role,
  bio: data.bio,
  tiptap_json: data.tiptap_json,
  avatar_url: data.avatar_url,
  publish_status: data.publish_status,
  github_url: developer.github_url,
  email: developer.email,
  website_url: developer.website_url,
  tech_stack: tryParseJson<string[]>(developer.tech_stack),
};
---

<AdminFormLayout
  title={`${t("admin.edit")} · ${developer.name}`}
  headerTitle={t("admin.edit")}
  headerSubtitle={developer.name}
  backHref="/admin/developers"
  backLabel={t("admin.backToDevelopers")}
  currentPath="/admin/developers"
  viewHref={`/admin/developers/view/${id}?locale=${locale}`}
  viewLabel={t("admin.view")}
>
  <DeveloperEditor
    client:only="react"
    initialData={initialData}
    translations={ui[DEFAULT_LANGUAGE] ?? {}}
  />
</AdminFormLayout>
