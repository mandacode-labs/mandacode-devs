---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { TagDetail } from "@/components/admin/TagDetail";
import { requireAuth } from "@/lib/auth";
import { getTagById, getTagUsage } from "@/lib/db/tags";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE } from "@/lib/config/languages";

requireAuth(Astro);

const { id } = Astro.params;
const tagId = Number(id);
if (!Number.isInteger(tagId) || tagId <= 0) {
  return Astro.redirect("/admin/tags");
}

const tag = await getTagById(tagId);
if (!tag) {
  return Astro.redirect("/admin/tags");
}

const usage = await getTagUsage(tagId);
const t = useTranslations(DEFAULT_LANGUAGE);
---

<AdminLayout title={`${tag.name} · ${t("admin.tags")}`}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath="/admin/tags" />

    <div class="flex-1 md:ml-64">
      <AdminHeader title={t("admin.tags")} subtitle={tag.name} />

      <main class="p-4 sm:p-6 lg:p-8">
        <div class="mb-6">
          <a
            href="/admin/tags"
            class="inline-flex items-center gap-1 text-sm text-text-secondary hover:text-text-primary transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-4 h-4"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
            {t("admin.backToTags")}
          </a>
        </div>

        <TagDetail
          tag={tag}
          usage={usage}
          nameLabel={t("admin.tagName")}
          renameLabel={t("admin.rename")}
          renameHint={t("admin.renameHint")}
          renameSuccessLabel={t("admin.tagRenamed")}
          deleteLabel={t("admin.delete")}
          deleteConfirmLabel={t("admin.deleteTagConfirm")}
          deleteSuccessLabel={t("admin.tagDeleted")}
          usageLabel={t("admin.usage")}
          noUsageLabel={t("admin.noUsage")}
          viewLabel={t("admin.view")}
          postLabel={t("admin.posts")}
          projectLabel={t("admin.projects")}
          developerLabel={t("admin.developer")}
          client:only="react"
        />
      </main>
    </div>
  </div>
</AdminLayout>
