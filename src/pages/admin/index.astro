---
import Layout from "@/components/layouts/Layout.astro";
import { getAuthenticatedUser } from "@/lib/auth";

const user = getAuthenticatedUser(Astro);
---

<Layout title="Admin Dashboard">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Admin Dashboard</h1>

    {
      user ? (
        <p class="mb-6 text-text-secondary">Logged in as {user.email}</p>
      ) : (
        <p class="mb-6 text-text-secondary">Not authenticated</p>
      )
    }

    <nav class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href="/admin/posts/new"
        class="p-6 border border-border rounded-xl hover:border-border-hover bg-bg-primary"
      >
        <h2 class="text-xl font-semibold">New Post</h2>
        <p class="text-text-secondary mt-2">Create a new blog post</p>
      </a>
      <a
        href="/admin/projects/new"
        class="p-6 border border-border rounded-xl hover:border-border-hover bg-bg-primary"
      >
        <h2 class="text-xl font-semibold">New Project</h2>
        <p class="text-text-secondary mt-2">Create a new project</p>
      </a>
      <a
        href="/admin/developers/new"
        class="p-6 border border-border rounded-xl hover:border-border-hover bg-bg-primary"
      >
        <h2 class="text-xl font-semibold">New Developer</h2>
        <p class="text-text-secondary mt-2">Create a new developer profile</p>
      </a>
    </nav>
  </div>
</Layout>
