---
import Layout from "@/components/layouts/Layout.astro";
import { getAuthenticatedUser } from "@/lib/auth";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE } from "@/lib/config/languages";

const user = getAuthenticatedUser(Astro);
const t = useTranslations(DEFAULT_LANGUAGE);
---

<Layout title={t("admin.title")}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold">{t("admin.dashboard")}</h1>
      {user && <p class="text-text-secondary">{user.email}</p>}
    </div>

    <nav class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <a
        href="/admin/posts"
        class="p-6 border border-border rounded-xl hover:border-border-hover bg-bg-primary"
      >
        <h2 class="text-xl font-semibold">{t("admin.posts")}</h2>
        <p class="text-text-secondary mt-2">Manage blog posts</p>
      </a>
      <a
        href="/admin/projects"
        class="p-6 border border-border rounded-xl hover:border-border-hover bg-bg-primary"
      >
        <h2 class="text-xl font-semibold">{t("admin.projects")}</h2>
        <p class="text-text-secondary mt-2">Manage projects</p>
      </a>
      <a
        href="/admin/developers"
        class="p-6 border border-border rounded-xl hover:border-border-hover bg-bg-primary"
      >
        <h2 class="text-xl font-semibold">{t("admin.developer")}</h2>
        <p class="text-text-secondary mt-2">Manage developer profile</p>
      </a>
    </nav>
  </div>
</Layout>
