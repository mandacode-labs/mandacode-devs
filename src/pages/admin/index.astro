---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import AdminCard from "@/components/admin/AdminCard.astro";
import StatusBadge from "@/components/admin/StatusBadge.astro";
import LocaleChip from "@/components/admin/LocaleChip.astro";
import { getAuthenticatedUser } from "@/lib/auth";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, MAIN_DEVELOPER_ID } from "@/lib/config/languages";
import { getAllPosts } from "@/lib/db/posts";
import { getAllProjects } from "@/lib/db/projects";
import { getAllDevelopers } from "@/lib/db/developers";
import type { Post, Project } from "@/lib/db/schema";

const user = getAuthenticatedUser(Astro);
const t = useTranslations(DEFAULT_LANGUAGE);

const [posts, projects, developers] = await Promise.all([
  getAllPosts(),
  getAllProjects(),
  getAllDevelopers(),
]);

const publishedPosts = posts.filter((p) => p.publish_status === "published");
const archivedPosts = posts.filter((p) => p.publish_status === "archived");
const draftPosts = posts.filter((p) => p.publish_status === "draft");

const publishedProjects = projects.filter(
  (p) => p.publish_status === "published",
);
const archivedProjects = projects.filter(
  (p) => p.publish_status === "archived",
);

const developerName =
  developers.find(
    (d) => d.id === MAIN_DEVELOPER_ID && d.locale === DEFAULT_LANGUAGE,
  )?.name ??
  developers.find((d) => d.id === MAIN_DEVELOPER_ID)?.name ??
  "—";

interface RecentItem {
  id: string;
  locale: string;
  title: string;
  type: "post" | "project";
  publish_status: "draft" | "published" | "archived";
  updated: string;
}

const recentItems: RecentItem[] = [
  ...posts.map((p: Post) => ({
    id: p.id,
    locale: p.locale,
    title: p.title,
    type: "post" as const,
    publish_status: p.publish_status,
    updated: p.updated_at,
  })),
  ...projects.map((p: Project) => ({
    id: p.id,
    locale: p.locale,
    title: p.title,
    type: "project" as const,
    publish_status: p.publish_status,
    updated: p.updated_at,
  })),
]
  .sort((a, b) => new Date(b.updated).getTime() - new Date(a.updated).getTime())
  .slice(0, 5);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<AdminLayout title={t("admin.dashboard")}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={Astro.url.pathname} />

    <div class="flex-1 md:ml-64">
      <AdminHeader
        title={t("admin.dashboard")}
        subtitle="Overview of your content"
      />

      <main class="p-4 sm:p-6 lg:p-8">
        {
          !user && (
            <div class="mb-6 p-4 rounded-lg border border-yellow-200 bg-yellow-50 text-yellow-800 text-sm">
              Not authenticated
            </div>
          )
        }

        <!-- Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
          <AdminCard class="p-5">
            <p class="text-sm text-text-secondary mb-1">Total Posts</p>
            <p class="text-3xl font-bold text-text-primary">{posts.length}</p>
            <div class="mt-3 flex items-center gap-2 text-xs">
              <span class="text-green-600 font-medium"
                >{publishedPosts.length} published</span
              >
              <span class="text-text-muted">·</span>
              <span class="text-yellow-600 font-medium"
                >{draftPosts.length} draft</span
              >
            </div>
          </AdminCard>

          <AdminCard class="p-5">
            <p class="text-sm text-text-secondary mb-1">Total Projects</p>
            <p class="text-3xl font-bold text-text-primary">
              {projects.length}
            </p>
            <div class="mt-3 flex items-center gap-2 text-xs">
              <span class="text-green-600 font-medium"
                >{publishedProjects.length} published</span
              >
            </div>
          </AdminCard>

          <AdminCard class="p-5">
            <p class="text-sm text-text-secondary mb-1">Archived Items</p>
            <p class="text-3xl font-bold text-text-primary">
              {archivedPosts.length + archivedProjects.length}
            </p>
            <div class="mt-3 flex items-center gap-2 text-xs text-text-muted">
              <span>{archivedPosts.length} posts</span>
              <span>·</span>
              <span>{archivedProjects.length} projects</span>
            </div>
          </AdminCard>

          <AdminCard class="p-5">
            <p class="text-sm text-text-secondary mb-1">Developer Profile</p>
            <p class="text-lg font-semibold text-text-primary truncate">
              {developerName}
            </p>
            <div class="mt-3">
              <a
                href={`/admin/developers/edit/${MAIN_DEVELOPER_ID}?locale=${DEFAULT_LANGUAGE}`}
                class="text-xs font-medium text-accent hover:text-accent-hover"
              >
                Edit profile →
              </a>
            </div>
          </AdminCard>
        </div>

        <!-- Quick actions -->
        <AdminCard class="p-5 mb-8">
          <h2
            class="text-sm font-semibold text-text-secondary uppercase tracking-wide mb-4"
          >
            Quick Actions
          </h2>
          <div class="flex flex-wrap gap-3">
            <a
              href="/admin/posts/new"
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
              {t("admin.newPost")}
            </a>
            <a
              href="/admin/projects/new"
              class="inline-flex items-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M12 5v14M5 12h14"></path>
              </svg>
              {t("admin.newProject")}
            </a>
            <a
              href={`/admin/developers/edit/${MAIN_DEVELOPER_ID}?locale=${DEFAULT_LANGUAGE}`}
              class="inline-flex items-center gap-2 px-4 py-2.5 border border-border text-text-primary text-sm font-medium rounded-lg hover:bg-bg-secondary transition-colors"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                class="w-4 h-4"
              >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              {t("admin.developer")}
            </a>
          </div>
        </AdminCard>

        <!-- Recent activity -->
        <AdminCard class="overflow-hidden">
          <div
            class="px-5 py-4 border-b border-border flex items-center justify-between"
          >
            <h2
              class="text-sm font-semibold text-text-secondary uppercase tracking-wide"
            >
              Recently Updated
            </h2>
            <a
              href="/admin/posts"
              class="text-xs text-accent hover:text-accent-hover font-medium"
              >View all →</a
            >
          </div>

          {
            recentItems.length === 0 ? (
              <div class="px-5 py-12 text-center">
                <p class="text-sm text-text-secondary">No recent activity</p>
              </div>
            ) : (
              <table class="w-full text-sm">
                <tbody class="divide-y divide-border">
                  {recentItems.map((item) => (
                    <tr class="hover:bg-bg-secondary/50 transition-colors">
                      <td class="px-5 py-3.5">
                        <div class="flex items-center gap-3">
                          <span
                            class={`w-2 h-2 rounded-full ${
                              item.type === "post" ? "bg-accent" : "bg-blue-500"
                            }`}
                          />
                          <div>
                            <p class="font-medium text-text-primary">
                              {item.title}
                            </p>
                            <p class="text-xs text-text-muted">{item.id}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-5 py-3.5">
                        <span class="text-xs text-text-secondary capitalize">
                          {item.type}
                        </span>
                      </td>
                      <td class="px-5 py-3.5">
                        <LocaleChip locale={item.locale} />
                      </td>
                      <td class="px-5 py-3.5">
                        <StatusBadge status={item.publish_status} />
                      </td>
                      <td class="px-5 py-3.5 text-right text-text-muted">
                        {formatDate(item.updated)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )
          }
        </AdminCard>
      </main>
    </div>
  </div>
</AdminLayout>
