---
import AdminLayout from "@/components/layouts/AdminLayout.astro";
import AdminSidebar from "@/components/admin/AdminSidebar.astro";
import AdminHeader from "@/components/admin/AdminHeader.astro";
import { AdminList } from "@/components/admin/AdminList";
import { requireAuth } from "@/lib/auth";
import { getAllProjects } from "@/lib/db/projects";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";
import type { Project } from "@/lib/db/schema";
import type { AdminListItem } from "@/components/admin/AdminList";

requireAuth(Astro);

const projects = await getAllProjects();
const t = useTranslations(DEFAULT_LANGUAGE);

const grouped = projects.reduce(
  (acc, project) => {
    if (!acc[project.id]) acc[project.id] = [];
    acc[project.id].push(project);
    return acc;
  },
  {} as Record<string, Project[]>,
);

const groupedArray = Object.entries(grouped).map(([id, locales]) => {
  const primary =
    locales.find((p) => p.locale === DEFAULT_LANGUAGE) || locales[0];
  const missingLocales = SUPPORTED_LANGUAGES.filter(
    (lang) => !locales.some((p) => p.locale === lang),
  );
  return { id, locales, primary, missingLocales };
});

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("ko-KR", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}

function formatProjectPeriod(start: string | null, end: string | null): string {
  if (start && end) return `${start} ~ ${end}`;
  if (start) return `${start} ~`;
  if (end) return `~ ${end}`;
  return "-";
}

const items: AdminListItem[] = groupedArray.map(
  ({ id, locales, primary, missingLocales }) => ({
    id,
    title: primary.title,
    href: `/admin/projects/edit/${id}?locale=${DEFAULT_LANGUAGE}`,
    meta: `/${id}`,
    status: primary.publish_status,
    locales: [
      ...locales.map((project) => ({
        locale: project.locale,
        href: `/admin/projects/edit/${project.id}?locale=${project.locale}`,
        active: project.publish_status !== "archived",
        title: `Edit ${project.locale}`,
      })),
      ...missingLocales.map((locale) => ({
        locale,
        href: `/admin/projects/edit/${id}?locale=${locale}`,
        active: false,
        title: `Create ${locale}`,
      })),
    ],
    extras: {
      order: `#${primary.project_order}`,
      period: formatProjectPeriod(primary.start_date, primary.end_date),
      updated: formatDate(primary.updated_at),
    },
  }),
);

const translations: Record<string, string> = {};
---

<AdminLayout title={t("admin.projects")}>
  <div class="flex min-h-screen">
    <AdminSidebar currentPath={Astro.url.pathname} />

    <div class="flex-1 md:ml-64">
      <AdminHeader
        title={t("admin.projects")}
        subtitle="Manage projects across languages"
      />

      <main class="p-4 sm:p-6 lg:p-8">
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
        >
          <div>
            <h1 class="text-2xl font-bold text-text-primary">
              {t("admin.projects")}
            </h1>
            <p class="text-sm text-text-secondary mt-1">
              {Object.keys(grouped).length} projects · {projects.length} language
              versions
            </p>
          </div>
          <a
            href="/admin/projects/new"
            class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="w-4 h-4"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            {t("admin.newProject")}
          </a>
        </div>

        <AdminList
          items={items}
          contentType="project"
          entityType="projects"
          reorderable={true}
          reorderLabels={{
            start: t("admin.reorder"),
            save: t("admin.saveOrder"),
            saving: t("admin.savingOrder"),
            saved: t("admin.orderSaved"),
            failed: t("admin.orderSaveFailed"),
            cancel: t("admin.cancel"),
            hint: t("admin.reorderHint"),
            activeHint: t("admin.reorderActiveHint"),
          }}
          reorderEndpoint="/api/admin/projects/reorder"
          columns={[
            { key: "status", label: t("admin.status") },
            { key: "order", label: t("admin.order"), width: "w-24" },
            { key: "period", label: t("admin.duration") },
            { key: "updated", label: t("admin.updated") },
          ]}
          emptyTitle={t("admin.noItems")}
          emptyMessage="Create your first project to get started."
          deleteModalTitle={t("admin.deleteProject")}
          translations={translations}
          client:only="react"
        />
      </main>
    </div>
  </div>
</AdminLayout>
