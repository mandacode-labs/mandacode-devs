---
import AdminPageLayout from "@/components/admin/AdminPageLayout.astro";
import { AdminList } from "@/components/admin/AdminList";
import { requireAuth } from "@/lib/auth";
import {
  getProjects,
  getProjectLocales,
  getProjectLocaleMeta,
  getProjectOriginalHash,
} from "@/lib/db/projects";
import { useTranslations } from "@/lib/i18n/utils";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";
import { formatShortDate } from "@/lib/utils/date";
import { formatProjectPeriod } from "@/lib/content/project-period";
import type { AdminListItem } from "@/components/admin/AdminList";

requireAuth(Astro);

const projects = await getProjects(DEFAULT_LANGUAGE, {
  includeUnpublished: true,
});
const t = useTranslations(DEFAULT_LANGUAGE);

const itemsWithLocales = await Promise.all(
  projects.map(async (project) => {
    const [existingLocales, localeMeta, originalHash] = await Promise.all([
      getProjectLocales(project.id),
      getProjectLocaleMeta(project.id),
      getProjectOriginalHash(project.id),
    ]);
    const missingLocales = SUPPORTED_LANGUAGES.filter(
      (lang) => !existingLocales.includes(lang),
    );
    return {
      project,
      existingLocales,
      missingLocales,
      localeMeta,
      originalHash,
    };
  }),
);

const items: AdminListItem[] = itemsWithLocales.map(
  ({ project, existingLocales, missingLocales, localeMeta, originalHash }) => ({
    id: project.id,
    title: project.title,
    href: `/admin/projects/edit/${project.id}?locale=${DEFAULT_LANGUAGE}`,
    viewHref: `/admin/projects/view/${project.id}?locale=${DEFAULT_LANGUAGE}`,
    meta: `/${project.id}`,
    originalLocale: project.original_locale,
    existingLocales,
    locales: [
      ...existingLocales.map((locale) => {
        const meta = localeMeta.find((m) => m.locale === locale);
        const isOutdated =
          originalHash !== null &&
          meta !== undefined &&
          meta.source_hash !== null &&
          meta.source_hash !== originalHash;
        return {
          locale,
          href: `/admin/projects/edit/${project.id}?locale=${locale}`,
          active: true,
          title: `Edit ${locale}`,
          publishStatus: meta?.publish_status ?? null,
          isOutdated,
        };
      }),
      ...missingLocales.map((locale) => ({
        locale,
        href: `/admin/projects/edit/${project.id}?locale=${locale}`,
        active: false,
        title: `Create ${locale}`,
        publishStatus: null,
        isOutdated: false,
      })),
    ],
    extras: {
      order: `#${project.project_order}`,
      period: formatProjectPeriod(
        { startDate: project.start_date, endDate: project.end_date },
        DEFAULT_LANGUAGE,
      ),
      updated: formatShortDate(project.updated_at),
    },
  }),
);

const totalLocales = itemsWithLocales.reduce(
  (sum, { existingLocales }) => sum + existingLocales.length,
  0,
);

const translations: Record<string, string> = {};
---

<AdminPageLayout
  title={t("admin.projects")}
  headerTitle={t("admin.projects")}
  headerSubtitle="Manage projects across languages"
  currentPath={Astro.url.pathname}
>
  <div
    class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6"
  >
    <div>
      <h1 class="text-2xl font-bold text-text-primary">
        {t("admin.projects")}
      </h1>
      <p class="text-sm text-text-secondary mt-1">
        {projects.length} projects · {totalLocales} language versions
      </p>
    </div>
    <a
      href="/admin/projects/new"
      class="inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-accent text-white text-sm font-medium rounded-lg hover:bg-accent-hover transition-colors"
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="w-4 h-4"
      >
        <path d="M12 5v14M5 12h14"></path>
      </svg>
      {t("admin.newProject")}
    </a>
  </div>

  <AdminList
    items={items}
    contentType="project"
    entityType="projects"
    statusLabel={t("admin.statusColumn")}
    reorderable={true}
    reorderLabels={{
      start: t("admin.reorder"),
      save: t("admin.saveOrder"),
      saving: t("admin.savingOrder"),
      saved: t("admin.orderSaved"),
      failed: t("admin.orderSaveFailed"),
      cancel: t("admin.cancel"),
      hint: t("admin.reorderHint"),
      activeHint: t("admin.reorderActiveHint"),
    }}
    reorderEndpoint="/api/admin/projects/reorder"
    columns={[
      { key: "order", label: t("admin.order"), width: "w-24" },
      { key: "period", label: t("admin.duration") },
      { key: "updated", label: t("admin.updated") },
    ]}
    emptyTitle={t("admin.noItems")}
    emptyMessage="Create your first project to get started."
    deleteModalTitle={t("admin.deleteProject")}
    translations={translations}
    client:only="react"
  />
</AdminPageLayout>
