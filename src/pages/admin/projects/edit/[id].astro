---
import AdminFormLayout from "@/components/admin/AdminFormLayout.astro";
import ProjectEditor from "@/components/admin/ProjectEditor";
import { requireAuth } from "@/lib/auth";
import {
  getProjectById,
  getProjectTranslationById,
  getProjectLocales,
} from "@/lib/db/projects";
import { getProjectTags } from "@/lib/db/tags";
import { useTranslations } from "@/lib/i18n/utils";
import { ui } from "@/lib/i18n";
import { DEFAULT_LANGUAGE } from "@/lib/config/languages";

requireAuth(Astro);

const { id } = Astro.params;
const locale = Astro.url.searchParams.get("locale") || DEFAULT_LANGUAGE;
const t = useTranslations(DEFAULT_LANGUAGE);

if (!id) {
  return Astro.redirect("/admin/projects");
}

const project = await getProjectById(id, locale);

if (!project) {
  return Astro.redirect("/admin/projects");
}

const [translation, existingLocales, tags] = await Promise.all([
  getProjectTranslationById(id, locale),
  getProjectLocales(id),
  getProjectTags(id),
]);

const data = translation ?? project;

const initialData = {
  id: project.id,
  locale,
  original_locale: project.original_locale,
  existing_locales: existingLocales,
  title: data.title,
  description: data.description,
  intro: data.intro,
  publish_status: data.publish_status,
  project_status: project.project_status,
  start_date: project.start_date,
  end_date: project.end_date,
  team_size: project.team_size,
  role: data.role,
  project_order: project.project_order,
  url: project.url,
  source_url: project.source_url,
  blog_post_id: project.blog_post_id,
  cover_image_url: data.cover_image_url,
  tags,
};
---

<AdminFormLayout
  title={`${t("admin.edit")} · ${project.title}`}
  headerTitle={t("admin.edit")}
  headerSubtitle={project.title}
  backHref="/admin/projects"
  backLabel={t("admin.backToProjects")}
  currentPath="/admin/projects"
  viewHref={`/admin/projects/view/${id}?locale=${locale}`}
  viewLabel={t("admin.view")}
>
  <ProjectEditor
    client:only="react"
    initialData={initialData}
    translations={ui[DEFAULT_LANGUAGE] ?? {}}
  />
</AdminFormLayout>
