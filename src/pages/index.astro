---
import Layout from "@/components/layouts/Layout.astro";
import NavigationCard from "@/components/content/NavigationCard.astro";
import { useTranslations } from "@/lib/i18n/utils";
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE } from "@/lib/config/languages";

const t = useTranslations(DEFAULT_LANGUAGE);

const cards = [
  {
    title: t("projects.title"),
    description: t("projects.subtitle"),
    href: `/${DEFAULT_LANGUAGE}/projects`,
    icon: "folder",
  },
  {
    title: t("developer.title"),
    description: t("developer.subtitle"),
    href: `/${DEFAULT_LANGUAGE}/developer`,
    icon: "user",
  },
  {
    title: t("blog.title"),
    description: t("blog.subtitle"),
    href: `/${DEFAULT_LANGUAGE}/blog`,
    icon: "bookOpen",
  },
];
---

<Layout>
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <header class="text-center mb-16">
      <div class="flex justify-center mb-6">
        <img
          src="https://static.mandacode.com/mandacode-devs/mandacode.webp"
          alt="Mandacode"
          width="200"
          height="auto"
          class="opacity-90"
        />
      </div>

      <h2 class="mb-4">
        {t("hero.title")}
      </h2>

      <p class="text-lg text-text-secondary max-w-xl mx-auto">
        {t("hero.subtitle")}
      </p>
    </header>

    <nav class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        cards.map((card) => (
          <NavigationCard
            title={card.title}
            description={card.description}
            href={card.href}
            icon={card.icon}
            linkText={t("viewDetail")}
          />
        ))
      }
    </nav>
  </section>
</Layout>

<script is:inline define:vars={{ SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE }}>
  // Detect browser language and redirect to appropriate locale
  (function () {
    const userLang =
      navigator.language || navigator.languages?.[0] || DEFAULT_LANGUAGE;
    const primaryLang = userLang.split("-")[0].toLowerCase();

    if (
      SUPPORTED_LANGUAGES.includes(primaryLang) &&
      primaryLang !== DEFAULT_LANGUAGE
    ) {
      window.location.replace(`/${primaryLang}/`);
    }
  })();
</script>
