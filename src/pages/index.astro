---
import Layout from "@/components/layouts/Layout.astro";
import HomePage from "@/components/home/HomePage.astro";
import { DEFAULT_LANGUAGE, SUPPORTED_LANGUAGES } from "@/lib/config/languages";

const supportedLanguages = SUPPORTED_LANGUAGES;
const defaultLanguage = DEFAULT_LANGUAGE;
---

<Layout>
  <HomePage lang={defaultLanguage} />
</Layout>

<script
  is:inline
  define:vars={{ supportedLanguages, defaultLanguage }}
  data-language-redirect
>
  (function () {
    function getCookie(name) {
      const value = `; ${document.cookie}`;
      const parts = value.split(`; ${name}=`);
      if (parts.length === 2) return parts.pop().split(";").shift();
      return null;
    }

    function setCookie(name, value) {
      const maxAge = 60 * 60 * 24 * 365;
      document.cookie = `${name}=${value}; Path=/; Max-Age=${maxAge}; SameSite=Lax; Secure`;
    }

    function detectLanguage() {
      const cookieLang = getCookie("lang");
      if (cookieLang && supportedLanguages.includes(cookieLang)) {
        return cookieLang;
      }

      const navigatorLang = navigator.language || navigator.userLanguage;
      const primaryLang = navigatorLang?.split("-")[0]?.toLowerCase();
      if (primaryLang && supportedLanguages.includes(primaryLang)) {
        setCookie("lang", primaryLang);
        return primaryLang;
      }

      setCookie("lang", defaultLanguage);
      return defaultLanguage;
    }

    const targetLang = detectLanguage();
    if (targetLang !== defaultLanguage) {
      window.location.replace(`/${targetLang}/`);
    }
  })();
</script>
